:host { display: inline-flex; flex-shrink: 0; vertical-align: middle; }
.venue-avatar { position: relative; flex-shrink: 0; overflow: hidden; border-radius: 24%; }
.venue-image, .venue-art { display: block; width: 100%; height: 100%; }
.accent-disc { position: absolute; top: 44%; width: 86%; height: 86%; border-radius: 50%; }
.court { position: absolute; left: 18%; top: 26%; width: 64%; height: 49%; border-radius: 7%; }
.court-boundary { position: absolute; top: 8%; right: 8%; bottom: 8%; left: 8%; border: 1rpx solid rgba(255, 255, 255, .85); border-radius: 2%; }
.court-center { position: absolute; left: 8%; right: 8%; top: 50%; height: 1rpx; background: rgba(255, 255, 255, .75); }
.court-net { position: absolute; left: 49%; top: -10%; bottom: -10%; width: 3%; border-radius: 1rpx; background: #fffdf6; }
.ball { position: absolute; width: 14%; height: 14%; border-radius: 50%; background: #fffdf6; box-shadow: 0 1rpx 3rpx rgba(22, 35, 28, .12); }
