:host { display: inline-flex; flex-shrink: 0; vertical-align: middle; }
.avatar { position: relative; overflow: hidden; flex-shrink: 0; border-radius: 50%; }
.avatar-image, .avatar-art { display: block; width: 100%; height: 100%; }
.orbit { position: absolute; width: 88%; height: 88%; left: 38%; top: 39%; border: 1rpx solid; border-radius: 50%; }
.racket { position: absolute; width: 55%; height: 79%; left: 22.5%; top: 13%; }
.blade { position: absolute; overflow: hidden; top: 0; left: 0; width: 100%; height: 72%; border-radius: 48%; }
.handle { position: absolute; width: 23%; height: 42%; top: 57%; left: 38.5%; border-radius: 0 0 4rpx 4rpx; }
.blade-stripe { position: absolute; width: 145%; height: 17%; left: -20%; bottom: 21%; transform: rotate(-35deg); }
.blade-dot { position: absolute; top: 23%; left: 29%; width: 9%; height: 8%; border-radius: 50%; background: #fff; opacity: .8; }
.ball { position: absolute; top: 19%; width: 16%; height: 16%; border-radius: 50%; background: #fffdf6; box-shadow: 0 1rpx 2rpx rgba(22, 35, 28, .1); }
