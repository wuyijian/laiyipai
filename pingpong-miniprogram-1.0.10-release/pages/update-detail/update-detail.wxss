.ui-screen { min-height: 100vh; background: #fff; }
.update-detail-page { padding: 18rpx 28rpx 0; }
.detail-loading { padding-top: 12rpx; }
.detail-skeleton { height: 330rpx; border-radius: 22rpx; }
.reply-skeleton { height: 104rpx; margin-top: 16rpx; border-radius: 18rpx; }
.detail-card { padding: 22rpx 0 30rpx; border-bottom: 1rpx solid var(--line); background: #fff; }
.detail-author { display: flex; width: 100%; align-items: center; gap: 16rpx; text-align: left; }
.author-copy { min-width: 0; flex: 1; }
.author-name { font-size: 28rpx; font-weight: 650; }
.author-meta { display: block; margin-top: 5rpx; color: var(--text-secondary); font-size: 21rpx; }
.kind-chip { margin-left: 12rpx; padding: 4rpx 9rpx; border-radius: 999rpx; background: var(--brand-soft); color: var(--brand); font-size: 18rpx; }
.kind-chip.tip { background: #f2f0e9; color: #6f5c35; }
.detail-chevron { color: var(--text-tertiary); font-size: 34rpx; }
.availability-block { display: flex; min-height: 96rpx; margin-top: 24rpx; padding: 18rpx 20rpx; align-items: flex-start; gap: 15rpx; border-radius: 16rpx; background: var(--brand-faint); }
.availability-mark { position: relative; width: 32rpx; height: 32rpx; margin-top: 3rpx; flex: none; border: 2rpx solid var(--brand); border-radius: 50%; }
.availability-mark::before, .availability-mark::after { position: absolute; left: 14rpx; top: 7rpx; width: 2rpx; height: 9rpx; border-radius: 2rpx; background: var(--brand); content: ''; transform-origin: bottom; }
.availability-mark::after { transform: rotate(120deg); }
.availability-copy { display: flex; min-width: 0; flex: 1; flex-direction: column; gap: 6rpx; }
.availability-title { color: var(--text); font-size: 29rpx; font-weight: 650; }
.availability-note, .availability-venue { color: var(--text-secondary); font-size: 22rpx; }
.availability-venue { display: flex; margin-top: 5rpx; align-items: center; gap: 9rpx; }
.detail-venue-pin { width: 16rpx; height: 16rpx; flex: none; border: 2rpx solid var(--brand); border-radius: 50% 50% 50% 0; transform: rotate(-45deg); }
.availability-venue text { min-width: 0; overflow: hidden; flex: 1; text-overflow: ellipsis; white-space: nowrap; }
.detail-content { margin-top: 22rpx; color: var(--text); font-size: 27rpx; line-height: 1.7; white-space: pre-wrap; overflow-wrap: anywhere; }
.detail-rating { display: inline-flex; margin-top: 18rpx; padding: 5rpx 10rpx; border-radius: 8rpx; background: #eef2e6; color: #536236; font-size: 19rpx; }
.create-match { margin-top: 24rpx; min-height: 82rpx; }
.reply-heading { display: flex; margin-top: 32rpx; align-items: flex-end; justify-content: space-between; gap: 16rpx; }
.reply-title { font-size: 29rpx; font-weight: 650; }
.reply-count { margin-left: 10rpx; color: var(--text-tertiary); font-size: 20rpx; }
.reply-hint { color: var(--text-tertiary); font-size: 19rpx; }
.reply-list { overflow: hidden; margin-top: 10rpx; background: #fff; }
.reply-row { display: flex; margin: 0; padding: 22rpx 0; gap: 15rpx; border-bottom: 1rpx solid var(--line); }
.reply-row:last-child { border-bottom: 0; }
.reply-avatar { flex: none; }
.reply-body { min-width: 0; flex: 1; }
.reply-meta { display: flex; align-items: baseline; justify-content: space-between; gap: 12rpx; color: var(--text-tertiary); font-size: 19rpx; }
.reply-name { color: var(--text); font-size: 23rpx; font-weight: 600; }
.reply-content { margin-top: 7rpx; color: var(--text); font-size: 24rpx; line-height: 1.6; white-space: pre-wrap; overflow-wrap: anywhere; }
.reply-empty, .reply-loading { margin-top: 14rpx; padding: 46rpx 28rpx; border-radius: 16rpx; background: var(--surface-muted); color: var(--text-secondary); font-size: 22rpx; line-height: 1.65; text-align: center; }
.reply-error { display: flex; margin-top: 14rpx; padding: 16rpx 18rpx; align-items: center; justify-content: space-between; gap: 14rpx; border-radius: 13rpx; background: #fff5ef; color: #805248; font-size: 21rpx; }
.reply-error button { color: var(--brand); font-size: 21rpx; }
.reply-more { display: flex; width: auto; min-height: 70rpx; margin: 18rpx auto 0; padding: 0 24rpx; align-items: center; justify-content: center; border: 1rpx solid var(--line); border-radius: 999rpx; color: var(--text-secondary); font-size: 22rpx; }
.composer-spacer { height: calc(170rpx + env(safe-area-inset-bottom)); }
.reply-composer { position: fixed; z-index: 10; right: 0; bottom: 0; left: 0; display: flex; min-height: 114rpx; padding: 17rpx 24rpx calc(17rpx + env(safe-area-inset-bottom)); align-items: flex-end; gap: 14rpx; border-top: 1rpx solid var(--line); background: rgba(255,255,255,.97); }
.reply-input { width: auto; min-width: 0; min-height: 76rpx; max-height: 180rpx; flex: 1; padding: 16rpx 18rpx; border-radius: 15rpx; background: #f1f3f1; font-size: 24rpx; line-height: 1.5; }
.send-reply { display: flex; width: 104rpx; height: 76rpx; flex: 0 0 104rpx; align-items: center; justify-content: center; border-radius: 14rpx; background: var(--brand); color: #fff; font-size: 23rpx; font-weight: 600; }
.send-reply[disabled] { background: #b5c2bb; }
.send-error { position: absolute; right: 24rpx; bottom: calc(100% + 6rpx); max-width: 560rpx; padding: 8rpx 12rpx; border-radius: 8rpx; background: #fff0ec; color: #9a4b40; font-size: 19rpx; }


