.home-page { overflow: hidden; padding-top: 16rpx; padding-bottom: calc(134rpx + env(safe-area-inset-bottom)); background: #fff; }
.home-page .home-topbar { display: flex; align-items: center; justify-content: space-between; min-height: 56rpx; gap: 20rpx; }
.home-page .location-picker { min-width: 0; flex: 1; }
.home-page .location-control { display: flex; align-items: center; min-height: 60rpx; gap: 8rpx; }
.home-page .location-dot { width: 12rpx; height: 12rpx; margin-right: 3rpx; border-radius: 50%; background: var(--brand); }
.home-page .city-name { font-size: 26rpx; font-weight: 600; }
.home-page .district-name { color: var(--text-secondary); font-size: 24rpx; }
.home-page .location-chevron, .home-page .filter-chevron { margin-left: 6rpx; color: var(--text-secondary); font-size: 22rpx; transform: translateY(-3rpx); }
.home-page .home-context { color: var(--text-tertiary); font-size: 22rpx; }
.home-page .home-top-actions { display: flex; flex: none; align-items: center; gap: 4rpx; }
.ui-screen .home-refresh { display: flex; align-items: center; justify-content: center; gap: 8rpx; width: auto; min-height: 64rpx; margin: 0; padding: 0 12rpx; color: var(--text-secondary); font-size: 22rpx; background: transparent; }
.ui-screen .home-refresh { color: var(--brand); }
.ui-screen .home-refresh[disabled] { color: var(--brand); background: transparent; opacity: .65; }
.home-page .refresh-icon { position: relative; width: 25rpx; height: 25rpx; border: 2rpx solid currentColor; border-right-color: transparent; border-radius: 50%; }
.home-page .refresh-icon::after { content: ''; position: absolute; right: -2rpx; top: -2rpx; width: 8rpx; height: 8rpx; border-top: 2rpx solid currentColor; border-right: 2rpx solid currentColor; transform: rotate(12deg); }
.home-page .is-refreshing { animation: refresh-spin .8s linear infinite; }
@keyframes refresh-spin { to { transform: rotate(360deg); } }
.home-page .refresh-feedback { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; margin-top: 18rpx; color: var(--brand); font-size: 23rpx; line-height: 1.5; }
.home-page .refresh-feedback.failed { color: var(--text-secondary); }
.home-page .refresh-feedback text { flex: 1; min-width: 0; }
.ui-screen .home-page .refresh-feedback button { flex: none; min-height: 64rpx; padding: 0 12rpx; color: var(--brand); font-size: 24rpx; }
.home-page .loading-caption { margin-bottom: 18rpx; color: var(--text-secondary); font-size: 24rpx; }
.home-page .loading-explanation { margin-bottom: 22rpx; color: var(--text-tertiary); font-size: 23rpx; line-height: 1.6; }
.home-page .home-hero { display: flex; align-items: center; justify-content: space-between; gap: 22rpx; padding: 30rpx 0 32rpx; }
.home-page .hero-copy { flex: 1; min-width: 0; }
.home-page .hero-title { font-size: 44rpx; font-weight: 650; line-height: 1.25; letter-spacing: -1rpx; }
.home-page .hero-subtitle { margin-top: 10rpx; color: var(--text-secondary); font-size: 24rpx; }
.home-page .publish-quick { display: flex; flex: 0 0 166rpx; width: 166rpx; min-height: 80rpx; margin: 0; padding: 0 16rpx; align-items: center; justify-content: center; gap: 4rpx; border-radius: 14rpx; background: var(--brand); color: #fff; font-size: 25rpx; font-weight: 600; line-height: 1.4; }
.home-page .publish-plus { font-size: 30rpx; font-weight: 400; }
.home-page .publish-quick-press { background: var(--brand-pressed); transform: scale(.98); }
.home-page .mode-switch { display: flex; gap: 40rpx; border-bottom: 1rpx solid var(--line); }
.home-page .mode-button { position: relative; display: flex; width: auto; min-height: 88rpx; margin: 0; padding: 0 2rpx; align-items: center; background: transparent; border-radius: 0; color: var(--text-secondary); line-height: 1.4; }
.home-page .mode-title { font-size: 31rpx; font-weight: 550; }
.home-page .mode-button.active { color: var(--text); }
.home-page .mode-button.active::before { position: absolute; bottom: 0; left: 0; right: 0; height: 5rpx; border-radius: 4rpx; background: var(--brand); content: ''; }
.home-page .mode-button.active .mode-title { font-weight: 650; }
.home-page .match-tools { padding-top: 28rpx; }
.home-page .tool-heading { display: flex; align-items: center; justify-content: space-between; margin-bottom: 18rpx; }
.home-page .tool-title { font-size: 25rpx; font-weight: 550; }
.home-page .refresh-copy { color: var(--brand); font-size: 22rpx; }
.home-page .date-scroll { width: calc(100% + 64rpx); margin: 0 -32rpx; white-space: nowrap; }
.home-page .date-track { display: inline-flex; gap: 10rpx; padding: 0 32rpx; }
.home-page .date-item { display: flex; flex: 0 0 84rpx; width: 84rpx; min-height: 98rpx; flex-direction: column; align-items: center; justify-content: center; border: 1rpx solid var(--line); border-radius: 14rpx; color: var(--text-secondary); background: #fff; }
.home-page .date-weekday { font-size: 21rpx; line-height: 1.3; }
.home-page .date-label { margin-top: 7rpx; color: var(--text); font-size: 25rpx; font-weight: 600; line-height: 1.3; }
.home-page .date-item.active { border-color: var(--brand); background: var(--brand); color: #fff; }
.home-page .date-item.active .date-label { color: #fff; }
.home-page .date-item-press { opacity: .72; }
.home-page .filter-row { display: flex; align-items: center; gap: 16rpx; margin-top: 18rpx; }
.home-page .filter-button { display: inline-flex; align-items: center; min-height: 64rpx; gap: 10rpx; padding: 0 18rpx; border: 1rpx solid var(--line); border-radius: 999rpx; color: var(--text-secondary); font-size: 23rpx; }
.home-page .friend-filter { display: inline-flex; width: auto; min-height: 64rpx; margin: 0; padding: 0 18rpx; align-items: center; gap: 9rpx; border: 1rpx solid var(--line); border-radius: 999rpx; color: var(--text-secondary); font-size: 23rpx; line-height: 1; }
.home-page .friend-filter.active { border-color: var(--brand); background: var(--brand-soft); color: var(--brand); }
.home-page .friend-filter-mark { position: relative; width: 30rpx; height: 22rpx; }
.home-page .friend-filter-mark view { position: absolute; top: 1rpx; width: 20rpx; height: 20rpx; box-sizing: border-box; border: 2rpx solid currentColor; border-radius: 50%; }
.home-page .friend-filter-mark view:first-child { left: 0; }
.home-page .friend-filter-mark view:last-child { right: 0; }
.home-page .section-head-row { display: flex; align-items: center; justify-content: space-between; gap: 20rpx; }
.home-page .matches-head, .home-page .coach-heading { margin-top: 34rpx; }
.home-page .result-count { color: var(--text-tertiary); font-size: 22rpx; text-align: right; }
.home-page .match-list { display: flex; flex-direction: column; gap: 18rpx; margin-top: 20rpx; }
.home-page .match-card { width: 100%; padding: 26rpx; border: 1rpx solid var(--line); border-radius: 20rpx; background: #fff; }
.home-page .match-card-press, .home-page .coach-row-press, .home-page .venue-card-press { background: var(--brand-faint); }
.home-page .match-card-head { display: flex; align-items: center; justify-content: space-between; gap: 12rpx; }
.home-page .match-schedule { display: flex; min-width: 0; flex: 1; flex-direction: column; gap: 4rpx; }
.home-page .match-date { font-size: 23rpx; color: var(--text-secondary); }
.home-page .match-time { font-size: 34rpx; font-weight: 650; letter-spacing: -.5rpx; line-height: 1.3; font-variant-numeric: tabular-nums; }
.home-page .seat-status { flex: none; padding: 6rpx 13rpx; border-radius: 8rpx; background: var(--brand-soft); color: var(--brand); font-size: 22rpx; }
.home-page .seat-status.full { background: var(--surface-muted); color: var(--text-secondary); }
.home-page .match-title { margin-top: 20rpx; overflow: hidden; font-size: 29rpx; font-weight: 600; text-overflow: ellipsis; white-space: nowrap; }
.home-page .match-venue-row { display: flex; flex-wrap: wrap; align-items: center; gap: 4rpx 16rpx; margin-top: 7rpx; }
.home-page .match-venue { font-size: 24rpx; color: var(--text-secondary); overflow-wrap: anywhere; }
.home-page .court-status { font-size: 21rpx; color: var(--text-tertiary); }
.home-page .match-location { display: flex; width: 100%; min-height: 52rpx; margin: 3rpx 0 0; padding: 0; align-items: center; justify-content: space-between; gap: 16rpx; color: var(--text-secondary); font-size: 21rpx; line-height: 1.5; text-align: left; }
.home-page .match-location > text:first-child { min-width: 0; flex: 1; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.home-page .match-location-action { flex: none; color: var(--brand); font-size: 20rpx; white-space: nowrap; }
.home-page .match-tags { display: flex; flex-wrap: wrap; gap: 8rpx; margin-top: 16rpx; }
.home-page .match-tags .pill { min-height: 40rpx; padding: 0 12rpx; font-size: 21rpx; background: var(--surface-muted); color: var(--text-secondary); }
.home-page .match-footer { display: flex; align-items: center; justify-content: space-between; gap: 20rpx; margin-top: 22rpx; padding-top: 18rpx; border-top: 1rpx solid var(--line); }
.home-page .join-mode { color: var(--text-secondary); font-size: 22rpx; }
.home-page .match-commitment, .home-page .coach-action { display: flex; flex: none; align-items: center; gap: 14rpx; }
.home-page .match-fee { font-size: 26rpx; font-weight: 600; }
.home-page .card-chevron { color: var(--text-tertiary); font-size: 33rpx; font-weight: 300; line-height: 1; }
.home-page .loading-list { padding-top: 34rpx; }
.home-page .skeleton-title { width: 200rpx; height: 36rpx; }
.home-page .skeleton-card { height: 290rpx; margin-top: 18rpx; }
.home-page .home-status { margin-top: 24rpx; }
.home-page .empty-panel { margin-top: 20rpx; padding: 52rpx 24rpx; border-radius: 18rpx; background: var(--surface-muted); }
.home-page .empty-publish-link { display: flex; width: auto; min-height: 80rpx; margin: 8rpx auto 0; padding: 0 24rpx; align-items: center; justify-content: center; color: var(--brand); font-size: 25rpx; line-height: 1.4; }
.home-page .pagination-area { display: flex; justify-content: center; margin-top: 22rpx; }
.home-page .pagination-more { display: flex; width: auto; min-height: 76rpx; margin: 0; padding: 0 30rpx; align-items: center; justify-content: center; border: 1rpx solid var(--line); border-radius: 14rpx; font-size: 24rpx; line-height: 1.4; color: var(--text-secondary); }
.home-page .pagination-error, .home-page .venue-load-error { display: flex; width: 100%; align-items: center; justify-content: space-between; gap: 20rpx; padding: 8rpx 20rpx; border-radius: 12rpx; background: var(--surface-muted); color: var(--text-secondary); font-size: 23rpx; }
.home-page .pagination-error text { flex: 1; min-width: 0; }
.home-page .pagination-error button, .home-page .venue-load-error button { width: auto; min-height: 64rpx; margin: 0; padding: 0 12rpx; color: var(--brand); font-size: 23rpx; line-height: 64rpx; }
.home-page .venue-load-error { margin-top: 28rpx; }
.home-page .venue-section { margin-top: 42rpx; padding-top: 30rpx; border-top: 1rpx solid var(--line); }
.home-page .venue-scroll { width: calc(100% + 64rpx); margin: 20rpx -32rpx 0; white-space: nowrap; }
.home-page .venue-track { display: inline-flex; gap: 14rpx; padding: 0 32rpx; }
.home-page .venue-card-wrap { position: relative; width: 450rpx; flex: 0 0 450rpx; }
.home-page .venue-card { display: flex; min-height: 176rpx; align-items: flex-start; padding: 22rpx 22rpx 68rpx; border: 1rpx solid var(--line); border-radius: 18rpx; background: #fff; white-space: normal; }
.home-page .venue-card-body { min-width: 0; flex: 1; padding-left: 16rpx; }
.home-page .venue-name { font-size: 26rpx; font-weight: 600; line-height: 1.4; }
.home-page .venue-meta-row { display: flex; align-items: flex-start; gap: 10rpx; margin-top: 6rpx; }
.home-page .venue-meta { min-width: 0; flex: 1; font-size: 22rpx; color: var(--text-secondary); line-height: 1.5; }
.home-page .venue-distance { color: var(--brand); font-weight: 550; }
.home-page .venue-map-shortcut { flex: none; min-height: 44rpx; padding: 0 4rpx 0 8rpx; color: var(--brand); font-size: 21rpx; line-height: 44rpx; }
.home-page .venue-map-shortcut text { margin-left: 2rpx; font-size: 19rpx; }
.home-page .venue-map-press { opacity: .58; }
.home-page .venue-activity-tags { display: flex; flex-wrap: wrap; gap: 4rpx 10rpx; margin-top: 7rpx; }
.home-page .venue-activity-tag { font-size: 21rpx; color: var(--text-secondary); }
.home-page .venue-verified { margin-top: 6rpx; font-size: 20rpx; color: var(--brand); }
.home-page .venue-chevron { position: absolute; right: 24rpx; top: 24rpx; color: var(--text-tertiary); font-size: 30rpx; }
.home-page .venue-card-actions { position: absolute; right: 18rpx; bottom: 7rpx; left: 110rpx; display: flex; min-height: 64rpx; align-items: center; justify-content: space-between; gap: 16rpx; }
.home-page .venue-mark-button { display: flex; min-width: 112rpx; min-height: 64rpx; align-items: center; color: var(--brand); font-size: 22rpx; }
.home-page .venue-mark-button.active { color: var(--text-secondary); }
.home-page .venue-mark-button.saving { opacity: .5; }
.home-page .venue-mark-press { opacity: .65; }
.home-page .venue-quick-publish { display: flex; min-height: 64rpx; align-items: center; justify-content: center; padding: 0 14rpx; color: var(--brand); font-size: 22rpx; font-weight: 550; }
.home-page .venue-publish-press { opacity: .58; }
.home-page .coach-list { display: flex; flex-direction: column; gap: 16rpx; margin-top: 20rpx; }
.home-page .coach-row { display: flex; width: 100%; margin: 0; padding: 24rpx; border: 1rpx solid var(--line); border-radius: 18rpx; text-align: left; line-height: 1.5; }
.home-page .coach-body { min-width: 0; flex: 1; padding-left: 20rpx; }
.home-page .coach-name-row { display: flex; align-items: center; gap: 12rpx; }
.home-page .coach-name { min-width: 0; flex: 1; font-size: 29rpx; font-weight: 600; }
.home-page .verified-label { flex: none; padding: 4rpx 9rpx; border-radius: 6rpx; background: var(--brand-soft); color: var(--brand); font-size: 20rpx; }
.home-page .coach-specialty { margin-top: 10rpx; font-size: 23rpx; color: var(--text-secondary); }
.home-page .coach-venue { margin-top: 6rpx; font-size: 22rpx; color: var(--text-tertiary); }
.home-page .coach-footer { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 12rpx; margin-top: 20rpx; padding-top: 16rpx; border-top: 1rpx solid var(--line); font-size: 22rpx; color: var(--text-secondary); }
.home-page .coach-price { font-size: 25rpx; color: var(--text); font-weight: 600; }
.home-page .updates-compose-card { display: flex; width: 100%; min-height: 104rpx; margin-top: 24rpx; padding: 18rpx; align-items: center; gap: 16rpx; border: 1rpx solid #dce5df; border-radius: 18rpx; background: #f7faf8; text-align: left; }
.home-page .updates-compose-press { border-color: #c8d9cf; background: var(--brand-faint); transform: scale(.995); }
.home-page .updates-compose-plus { position: relative; width: 52rpx; height: 52rpx; flex: 0 0 52rpx; border-radius: 50%; background: var(--brand); }
.home-page .updates-compose-plus::before, .home-page .updates-compose-plus::after { position: absolute; top: 25rpx; left: 16rpx; width: 20rpx; height: 2rpx; border-radius: 2rpx; background: #fff; content: ''; }
.home-page .updates-compose-plus::after { transform: rotate(90deg); }
.home-page .updates-compose-copy { display: flex; min-width: 0; flex: 1; flex-direction: column; gap: 3rpx; color: var(--text-secondary); font-size: 21rpx; line-height: 1.45; }
.home-page .updates-compose-copy > text:first-child { color: var(--text); font-size: 26rpx; font-weight: 650; }
.home-page .updates-compose-action { display: flex; min-width: 76rpx; min-height: 52rpx; flex: none; align-items: center; justify-content: center; padding: 0 16rpx; border-radius: 999rpx; background: var(--brand); color: #fff; font-size: 21rpx; font-weight: 600; }
.home-page .updates-heading { margin-top: 30rpx; }
.home-page .home-update-list { display: flex; margin-top: 8rpx; flex-direction: column; }
.home-page .home-update-card { padding: 26rpx 0 24rpx; border-bottom: 1rpx solid var(--line); background: #fff; }
.home-page .home-update-card:last-child { border-bottom: 0; }
.home-page .home-update-head { display: flex; align-items: flex-start; gap: 12rpx; }
.home-page .home-update-author { display: flex; min-width: 0; flex: 1; align-items: center; gap: 14rpx; text-align: left; }
.home-page .home-update-author-copy { min-width: 0; flex: 1; }
.home-page .home-update-name { color: var(--text); font-size: 27rpx; font-weight: 650; }
.home-page .home-score-chip { margin-left: 9rpx; padding: 3rpx 8rpx; border-radius: 7rpx; background: #eef2e6; color: #536236; font-size: 17rpx; }
.home-page .home-update-meta { display: block; margin-top: 4rpx; overflow: hidden; color: var(--text-secondary); font-size: 20rpx; text-overflow: ellipsis; white-space: nowrap; }
.home-page .home-update-kind { flex: none; margin-top: 4rpx; padding: 5rpx 10rpx; border-radius: 999rpx; background: #eef4f0; color: var(--brand); font-size: 18rpx; }
.home-page .home-update-kind.tip { background: #f2f0e9; color: #6f5c35; }
.home-page .home-update-detail { display: block; width: 100%; padding: 0; border: 0; border-radius: 0; background: transparent; color: inherit; line-height: inherit; text-align: left; }
.home-page .home-update-detail::after { display: none; }
.home-page .home-update-time { display: flex; min-height: 76rpx; margin-top: 18rpx; padding: 15rpx 17rpx; align-items: center; gap: 13rpx; border-radius: 14rpx; background: var(--brand-faint); color: var(--text); font-size: 24rpx; font-weight: 650; }
.home-page .home-time-mark { position: relative; width: 28rpx; height: 28rpx; flex: none; border: 2rpx solid var(--brand); border-radius: 50%; }
.home-page .home-time-mark::before, .home-page .home-time-mark::after { position: absolute; left: 12rpx; top: 6rpx; width: 2rpx; height: 8rpx; border-radius: 2rpx; background: var(--brand); content: ''; transform-origin: bottom; }
.home-page .home-time-mark::after { transform: rotate(120deg); }
.home-page .home-time-copy { min-width: 0; flex: 1; }
.home-page .home-time-note { display: block; margin-top: 4rpx; color: var(--text-secondary); font-size: 20rpx; font-weight: 400; }
.home-page .home-update-venue { display: flex; margin-top: 13rpx; align-items: center; gap: 9rpx; color: var(--text-secondary); font-size: 21rpx; }
.home-page .home-venue-pin { width: 16rpx; height: 16rpx; flex: none; border: 2rpx solid var(--brand); border-radius: 50% 50% 50% 0; transform: rotate(-45deg); }
.home-page .home-update-venue text { min-width: 0; overflow: hidden; flex: 1; text-overflow: ellipsis; white-space: nowrap; }
.home-page .home-update-content { display: -webkit-box; max-height: 198rpx; overflow: hidden; margin-top: 15rpx; color: var(--text); font-size: 24rpx; line-height: 1.65; white-space: pre-wrap; overflow-wrap: anywhere; -webkit-box-orient: vertical; -webkit-line-clamp: 5; }
.home-page .home-update-actions { display: flex; min-height: 62rpx; margin-top: 14rpx; align-items: center; gap: 8rpx; }
.home-page .home-match-from-update { min-height: 56rpx; padding: 0 16rpx; border-radius: 999rpx; background: var(--brand-soft); color: var(--brand); font-size: 20rpx; font-weight: 600; }
.home-page .home-reply-update { display: flex; min-height: 56rpx; padding: 0 12rpx; align-items: center; gap: 9rpx; color: var(--text-secondary); font-size: 20rpx; }
.home-page .home-reply-icon { position: relative; width: 23rpx; height: 18rpx; border: 2rpx solid currentColor; border-radius: 7rpx; }
.home-page .home-reply-icon::after { position: absolute; bottom: -5rpx; left: 4rpx; width: 6rpx; height: 6rpx; border-bottom: 2rpx solid currentColor; border-left: 2rpx solid currentColor; background: #fff; content: ''; transform: skewY(-32deg); }
.ui-screen .venue-create-button { display: flex; align-items: center; justify-content: center; flex: none; min-height: 76rpx; margin: 0; padding: 0 10rpx; width: auto; background: transparent; color: var(--brand); font-size: 23rpx; line-height: 1.3; }
