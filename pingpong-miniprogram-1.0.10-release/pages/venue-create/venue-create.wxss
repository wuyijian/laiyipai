.ui-screen .venue-entry-page { min-height: 100vh; box-sizing: border-box; padding: 34rpx 36rpx calc(330rpx + env(safe-area-inset-bottom)); background: #fff; }
.ui-screen .entry-heading { padding: 10rpx 0 40rpx; }
.ui-screen .entry-eyebrow { margin-bottom: 10rpx; color: var(--brand); font-size: 21rpx; font-weight: 650; letter-spacing: 2rpx; }
.ui-screen .entry-title { color: var(--text); font-size: 42rpx; font-weight: 650; letter-spacing: -1rpx; line-height: 1.3; }
.ui-screen .entry-subtitle { max-width: 620rpx; margin-top: 14rpx; color: var(--text-secondary); font-size: 25rpx; line-height: 1.65; }
.ui-screen .entry-city { display: flex; align-items: center; justify-content: space-between; padding-bottom: 24rpx; border-bottom: 1rpx solid var(--line); color: var(--text-secondary); font-size: 24rpx; }
.ui-screen .entry-city text:last-child { color: var(--text); font-weight: 550; }
.ui-screen .entry-field { margin-top: 32rpx; }
.ui-screen .entry-label { display: flex; align-items: center; gap: 14rpx; color: var(--text); font-size: 27rpx; font-weight: 600; }
.ui-screen .entry-input { width: 100%; height: 98rpx; box-sizing: border-box; margin-top: 16rpx; padding: 0 22rpx; border: 1rpx solid var(--line); border-radius: 16rpx; background: #fafbf9; color: var(--text); font-size: 28rpx; }
.ui-screen .entry-input:focus { border-color: #8fa79d; background: #fff; }
.ui-screen .entry-input.is-readonly { background: #f1f3ef; color: var(--text-secondary); }
.ui-screen .entry-placeholder { color: var(--text-tertiary); font-size: 25rpx; }
.ui-screen .entry-helper, .ui-screen .entry-search-note { margin-top: 12rpx; color: var(--text-secondary); font-size: 22rpx; line-height: 1.6; }
.ui-screen .entry-activities { margin-top: 38rpx; }
.ui-screen .entry-optional { color: var(--text-tertiary); font-size: 21rpx; font-weight: 400; }
.ui-screen .entry-tags { display: grid; grid-template-columns: repeat(4, 1fr); gap: 12rpx; margin-top: 18rpx; }
.ui-screen .entry-tag { display: flex; min-width: 0; min-height: 76rpx; margin: 0; padding: 0; align-items: center; justify-content: center; border: 1rpx solid var(--line); border-radius: 14rpx; background: #fff; color: var(--text-secondary); font-size: 24rpx; line-height: 1; }
.ui-screen .entry-tag.selected { border-color: #9bb8ad; background: var(--brand-soft); color: var(--brand); font-weight: 600; }
.ui-screen .entry-notice, .ui-screen .edit-review-note { display: flex; gap: 16rpx; margin-top: 34rpx; padding: 24rpx; border-radius: 16rpx; background: #f5f7f3; color: var(--text-secondary); }
.ui-screen .notice-dot { width: 12rpx; height: 12rpx; flex: none; margin-top: 10rpx; border-radius: 50%; background: var(--brand); }
.ui-screen .notice-title, .ui-screen .edit-review-title { display: block; color: var(--text); font-size: 24rpx; font-weight: 600; }
.ui-screen .notice-copy, .ui-screen .edit-review-note { font-size: 22rpx; line-height: 1.7; }
.ui-screen .edit-review-note { display: block; margin-top: 0; background: #fbf5ea; color: #796b50; }
.ui-screen .edit-review-note text:last-child { display: block; margin-top: 8rpx; }
.ui-screen .entry-suggestions { margin-top: 24rpx; overflow: hidden; border: 1rpx solid #cdd9d3; border-radius: 16rpx; }
.ui-screen .entry-suggestions-head { padding: 20rpx 22rpx; background: #f3f7f4; }
.ui-screen .entry-suggestions-title { color: var(--text); font-size: 24rpx; font-weight: 600; }
.ui-screen .entry-suggestions-copy { margin-top: 5rpx; color: var(--text-secondary); font-size: 21rpx; }
.ui-screen .entry-suggestion { display: flex; width: 100%; min-height: 92rpx; margin: 0; padding: 17rpx 20rpx; align-items: center; gap: 16rpx; border-radius: 0; background: #fff; color: var(--text); font-size: 24rpx; line-height: 1.4; text-align: left; }
.ui-screen .entry-suggestion + .entry-suggestion { border-top: 1rpx solid var(--line); }
.ui-screen .entry-suggestion-name { flex: 1; min-width: 0; overflow-wrap: break-word; }
.ui-screen .entry-suggestion-action { flex: none; color: var(--brand); font-size: 22rpx; font-weight: 550; }
.ui-screen .entry-result { padding: 28rpx; border: 1rpx solid var(--line); border-radius: 22rpx; background: #fff; box-shadow: 0 12rpx 40rpx rgba(20, 42, 34, .06); }
.ui-screen .entry-result.result-reviewing { border-color: #e6d6b5; background: #fffdf8; }
.ui-screen .entry-result.result-rejected { border-color: #ead2ce; background: #fffafa; }
.ui-screen .entry-result.result-approved, .ui-screen .entry-result-existing { border-color: #c9ddd5; background: #fbfefc; }
.ui-screen .result-topline { display: flex; margin-bottom: 30rpx; align-items: center; justify-content: space-between; }
.ui-screen .result-mark { display: flex; width: 48rpx; height: 48rpx; align-items: center; justify-content: center; border-radius: 50%; background: #efe9da; color: #8b7443; font-size: 26rpx; font-weight: 700; }
.ui-screen .result-mark.approved, .ui-screen .result-mark.existing-mark { background: #e3f0ea; color: var(--brand); }
.ui-screen .result-mark.rejected { background: #f5e5e2; color: var(--danger); }
.ui-screen .result-status { padding: 9rpx 15rpx; border-radius: 999rpx; background: #f2eadb; color: #826d42; font-size: 21rpx; font-weight: 600; }
.ui-screen .result-status.approved { background: #e4f0ea; color: var(--brand); }
.ui-screen .result-status.rejected { background: #f5e6e3; color: var(--danger); }
.ui-screen .entry-result-title { margin-top: 26rpx; color: var(--text); font-size: 31rpx; font-weight: 650; }
.ui-screen .entry-result-name { margin-top: 12rpx; color: var(--text); font-size: 27rpx; line-height: 1.45; }
.ui-screen .entry-result-copy { margin-top: 12rpx; color: var(--text-secondary); font-size: 23rpx; line-height: 1.7; }
.ui-screen .result-tags { display: flex; flex-wrap: wrap; gap: 10rpx; margin-top: 22rpx; }
.ui-screen .result-tags text { padding: 9rpx 14rpx; border-radius: 999rpx; background: #f0f3ef; color: var(--text-secondary); font-size: 21rpx; }
.ui-screen .review-note, .ui-screen .rejection-note { display: flex; margin-top: 26rpx; padding-top: 22rpx; flex-direction: column; gap: 8rpx; border-top: 1rpx solid rgba(30, 62, 48, .1); color: var(--text-secondary); font-size: 22rpx; line-height: 1.65; }
.ui-screen .rejection-note { color: #80645f; }
.ui-screen .review-note-title { color: var(--text); font-weight: 600; }
.ui-screen .entry-state-card { padding: 30rpx; border: 1rpx solid var(--line); border-radius: 20rpx; color: var(--text-secondary); font-size: 23rpx; line-height: 1.6; }
.ui-screen .entry-loading-line { width: 52%; height: 24rpx; margin-bottom: 15rpx; border-radius: 8rpx; background: #eef1ed; }
.ui-screen .entry-loading-line.wide { width: 78%; height: 34rpx; }
.ui-screen .entry-loading text { display: block; margin-top: 14rpx; }
.ui-screen .entry-state-title { color: var(--text); font-size: 28rpx; font-weight: 600; }
.ui-screen .entry-state-copy { margin: 12rpx 0 22rpx; }
.ui-screen .entry-dock { position: fixed; right: 0; bottom: 0; left: 0; z-index: 20; padding: 18rpx 36rpx calc(18rpx + env(safe-area-inset-bottom)); border-top: 1rpx solid var(--line); background: rgba(255, 255, 255, .98); }
.ui-screen .entry-submit, .ui-screen .entry-secondary { display: flex; width: 100%; min-height: 92rpx; margin: 0; align-items: center; justify-content: center; border-radius: 16rpx; background: var(--brand); color: #fff; font-size: 28rpx; font-weight: 600; line-height: 1.2; }
.ui-screen .entry-secondary { width: auto; min-height: 72rpx; padding: 0 28rpx; border: 1rpx solid var(--line); background: #fff; color: var(--text); font-size: 24rpx; }
.ui-screen .entry-secondary-full { width: 100%; min-height: 88rpx; }
.ui-screen .entry-submit[disabled] { background: var(--brand); color: #fff; opacity: .48; }
.ui-screen .entry-text-action { width: 100%; min-height: 56rpx; margin: 8rpx 0 0; padding: 0; background: transparent; color: var(--brand); font-size: 22rpx; line-height: 1; }
.ui-screen .entry-text-action.muted { margin-top: 0; color: var(--text-secondary); }
.ui-screen .entry-tag[disabled], .ui-screen .entry-suggestion[disabled], .ui-screen .entry-text-action[disabled] { opacity: .55; }
.ui-screen .entry-footnote { margin-top: 12rpx; color: var(--text-tertiary); font-size: 20rpx; text-align: center; }
.ui-screen .entry-error { margin-bottom: 14rpx; color: var(--danger); font-size: 23rpx; line-height: 1.55; }
.ui-screen .entry-press { opacity: .72; }
.ui-screen .entry-selector { display: flex; align-items: center; justify-content: space-between; }
.ui-screen .entry-address { height: 166rpx; padding: 22rpx; line-height: 1.6; }
.ui-screen .suggestion-address { margin-top: 6rpx; color: var(--text-secondary); font-size: 21rpx; line-height: 1.5; }
