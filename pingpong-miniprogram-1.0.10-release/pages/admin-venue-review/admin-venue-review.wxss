.ui-screen .admin-review-page { min-height: 100vh; box-sizing: border-box; padding: 32rpx 36rpx calc(64rpx + env(safe-area-inset-bottom)); background: #fff; }
.ui-screen .review-heading { display: flex; align-items: flex-end; justify-content: space-between; gap: 24rpx; padding: 8rpx 0 32rpx; border-bottom: 1rpx solid var(--line); }
.ui-screen .review-eyebrow { color: var(--brand); font-size: 21rpx; font-weight: 650; letter-spacing: 2rpx; }
.ui-screen .review-title { margin-top: 8rpx; color: var(--text); font-size: 42rpx; font-weight: 650; letter-spacing: -1rpx; line-height: 1.25; }
.ui-screen .review-subtitle { max-width: 530rpx; margin-top: 12rpx; color: var(--text-secondary); font-size: 23rpx; line-height: 1.6; }
.ui-screen .queue-count { display: flex; flex: 0 0 94rpx; height: 94rpx; align-items: center; justify-content: center; flex-direction: column; border-radius: 18rpx; background: var(--brand-faint); color: var(--brand); }
.ui-screen .queue-count text:first-child { font-size: 31rpx; font-weight: 700; line-height: 1.1; }
.ui-screen .queue-count text:last-child { margin-top: 5rpx; font-size: 18rpx; }
.ui-screen .review-list { padding-top: 8rpx; }
.ui-screen .review-row { display: flex; min-height: 124rpx; align-items: center; gap: 18rpx; padding: 20rpx 2rpx; border-bottom: 1rpx solid var(--line); background: #fff; }
.ui-screen .review-row-copy { flex: 1; min-width: 0; }
.ui-screen .review-row-title { overflow: hidden; color: var(--text); font-size: 27rpx; font-weight: 620; line-height: 1.4; text-overflow: ellipsis; white-space: nowrap; }
.ui-screen .review-row-meta { margin-top: 7rpx; color: var(--text-secondary); font-size: 21rpx; }
.ui-screen .review-row-tags { display: flex; flex-wrap: wrap; gap: 12rpx; margin-top: 8rpx; color: var(--text-secondary); font-size: 20rpx; }
.ui-screen .review-chevron { flex: none; color: #9da39e; font-size: 36rpx; font-weight: 300; }
.ui-screen .review-row-press { background: #f6f8f4 !important; }
.ui-screen .review-press { opacity: .72 !important; }
.ui-screen .review-loading { padding-top: 10rpx; }
.ui-screen .review-skeleton-row { display: flex; align-items: center; gap: 18rpx; min-height: 124rpx; border-bottom: 1rpx solid var(--line); }
.ui-screen .review-skeleton-avatar { width: 72rpx; height: 72rpx; flex: 0 0 72rpx; border-radius: 18rpx; }
.ui-screen .review-skeleton-copy { flex: 1; }
.ui-screen .review-skeleton-title { width: 58%; height: 28rpx; }
.ui-screen .review-skeleton-line { width: 42%; height: 20rpx; margin-top: 15rpx; }
.ui-screen .review-status { padding: 116rpx 22rpx; text-align: center; }
.ui-screen .empty-status { padding-top: 150rpx; }
.ui-screen .status-mark, .ui-screen .empty-check { display: flex; width: 66rpx; height: 66rpx; margin: 0 auto 24rpx; align-items: center; justify-content: center; border-radius: 50%; background: #edf2ee; color: var(--brand); font-size: 23rpx; font-weight: 650; }
.ui-screen .muted-mark { background: #f1f2ef; color: var(--text-secondary); font-size: 34rpx; }
.ui-screen .empty-check { font-size: 30rpx; }
.ui-screen .review-status .status-action { border-color: var(--brand); background: var(--brand); color: #fff; }
.ui-screen .sync-notice { display: flex; min-height: 74rpx; align-items: center; justify-content: space-between; gap: 20rpx; margin-top: 18rpx; padding: 0 18rpx; border-radius: 14rpx; background: #fbf5e9; color: #786945; font-size: 22rpx; }
.ui-screen .sync-notice button { flex: none; width: auto; min-height: 58rpx; margin: 0; padding: 0 12rpx; background: transparent; color: #6f5d34; font-size: 21rpx; font-weight: 650; line-height: 1; }
.ui-screen .load-more { display: flex; width: auto; min-width: 180rpx; min-height: 68rpx; margin: 24rpx auto 0; padding: 0 24rpx; align-items: center; justify-content: center; border-radius: 999rpx; background: var(--brand-faint); color: var(--brand); font-size: 22rpx; font-weight: 600; line-height: 1; }
.ui-screen .review-sheet-mask { position: fixed; z-index: 90; inset: 0; display: flex; align-items: flex-end; background: rgba(14, 19, 17, .46); }
.ui-screen .review-sheet { width: 100%; max-height: 92vh; box-sizing: border-box; overflow-y: auto; padding: 18rpx 32rpx calc(28rpx + env(safe-area-inset-bottom)); border-radius: 28rpx 28rpx 0 0; background: #fff; }
.ui-screen .sheet-handle { width: 68rpx; height: 7rpx; margin: 0 auto 28rpx; border-radius: 999rpx; background: #d9ddd8; }
.ui-screen .sheet-head { display: flex; align-items: flex-start; justify-content: space-between; gap: 24rpx; }
.ui-screen .sheet-kicker { color: var(--brand); font-size: 20rpx; font-weight: 650; letter-spacing: 1rpx; }
.ui-screen .sheet-name { margin-top: 9rpx; color: var(--text); font-size: 34rpx; font-weight: 650; line-height: 1.4; overflow-wrap: anywhere; }
.ui-screen .sheet-close { display: flex; flex: 0 0 64rpx; width: 64rpx; height: 64rpx; min-height: 64rpx; margin: 0; padding: 0; align-items: center; justify-content: center; border-radius: 50%; background: #eef0ec; color: #656c67; font-size: 36rpx; font-weight: 300; line-height: 1; }
.ui-screen .detail-facts { margin-top: 28rpx; border-top: 1rpx solid var(--line); }
.ui-screen .detail-fact { display: flex; min-height: 78rpx; align-items: center; justify-content: space-between; gap: 28rpx; border-bottom: 1rpx solid var(--line); font-size: 23rpx; }
.ui-screen .detail-fact text:first-child { color: var(--text-secondary); }
.ui-screen .detail-fact text:last-child { min-width: 0; overflow: hidden; color: var(--text); font-weight: 550; text-align: right; text-overflow: ellipsis; white-space: nowrap; }
.ui-screen .detail-section { padding: 25rpx 0; border-bottom: 1rpx solid var(--line); }
.ui-screen .detail-label { color: var(--text-secondary); font-size: 22rpx; }
.ui-screen .detail-tags { display: flex; flex-wrap: wrap; gap: 10rpx; margin-top: 14rpx; }
.ui-screen .detail-tags text { padding: 9rpx 14rpx; border-radius: 999rpx; background: var(--surface-muted); color: var(--text-secondary); font-size: 21rpx; }
.ui-screen .detail-empty { margin-top: 10rpx; color: var(--text-tertiary); font-size: 22rpx; }
.ui-screen .review-principle { display: flex; gap: 15rpx; margin-top: 24rpx; padding: 21rpx; border-radius: 15rpx; background: #f5f7f3; color: var(--text-secondary); font-size: 21rpx; line-height: 1.65; }
.ui-screen .principle-dot { width: 10rpx; height: 10rpx; flex: 0 0 10rpx; margin-top: 10rpx; border-radius: 50%; background: var(--brand); }
.ui-screen .detail-message { margin-top: 20rpx; padding: 18rpx 20rpx; border-radius: 13rpx; background: #fff1f0; color: var(--danger); font-size: 22rpx; line-height: 1.55; }
.ui-screen .detail-message.is-warning { background: #fbf5e8; color: #75633a; }
.ui-screen .review-actions, .ui-screen .reject-actions, .ui-screen .unknown-actions { display: grid; grid-template-columns: 1fr 1.65fr; gap: 12rpx; margin-top: 26rpx; }
.ui-screen .unknown-actions { grid-template-columns: 1fr 1fr; }
.ui-screen .unknown-actions.single-action { grid-template-columns: 1fr; }
.ui-screen .primary-action, .ui-screen .secondary-action, .ui-screen .danger-action { display: flex; width: 100%; min-height: 88rpx; margin: 0; padding: 0 18rpx; align-items: center; justify-content: center; border-radius: 15rpx; font-size: 26rpx; font-weight: 620; line-height: 1; }
.ui-screen .primary-action { background: var(--brand); color: #fff; }
.ui-screen .secondary-action { border: 1rpx solid var(--line); background: #fff; color: var(--text); }
.ui-screen .danger-action { background: #a9483d; color: #fff; }
.ui-screen .reject-panel { margin-top: 25rpx; }
.ui-screen .reject-label { color: var(--text); font-size: 24rpx; font-weight: 600; }
.ui-screen .reject-input { width: 100%; min-height: 150rpx; box-sizing: border-box; margin-top: 13rpx; padding: 20rpx; border: 1rpx solid var(--line); border-radius: 15rpx; background: #fafbf9; color: var(--text); font-size: 25rpx; line-height: 1.55; }
.ui-screen .reject-placeholder { color: var(--text-tertiary); }
.ui-screen .reject-meta { display: flex; min-height: 42rpx; align-items: center; justify-content: space-between; gap: 20rpx; margin-top: 8rpx; color: var(--text-tertiary); font-size: 20rpx; }
.ui-screen .reason-error { color: var(--danger); }
.ui-screen button[disabled] { opacity: .52; }
