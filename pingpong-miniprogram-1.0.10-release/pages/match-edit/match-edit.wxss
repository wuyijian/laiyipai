.ui-screen .edit-page { min-height: 100vh; padding: 22rpx 36rpx calc(210rpx + env(safe-area-inset-bottom)); background: #fff; }
.ui-screen .edit-heading { padding: 12rpx 0 34rpx; }
.ui-screen .edit-title { color: var(--text); font-size: 44rpx; font-weight: 650; letter-spacing: -1rpx; line-height: 1.3; }
.ui-screen .edit-copy { margin-top: 12rpx; color: var(--text-secondary); font-size: 25rpx; line-height: 1.6; }
.ui-screen .edit-section { padding: 32rpx 0; border-top: 1rpx solid var(--line); }
.ui-screen .section-heading, .ui-screen .label-line, .ui-screen .field-heading { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; }
.ui-screen .section-heading { margin-bottom: 22rpx; }
.ui-screen .section-label { color: var(--text); font-size: 29rpx; font-weight: 600; line-height: 1.5; }
.ui-screen .field-hint { color: var(--text-tertiary); font-size: 22rpx; font-weight: 400; line-height: 1.5; }
.ui-screen .input-placeholder { color: #8b948e; font-weight: 400; }
.ui-screen .title-input { width: 100%; height: 92rpx; margin-top: 16rpx; padding: 0 22rpx; border: 1rpx solid var(--line); border-radius: 14rpx; background: #fafbf9; color: var(--text); font-size: 32rpx; font-weight: 550; text-align: left; }
.ui-screen .date-row { display: flex; align-items: center; gap: 18rpx; min-height: 80rpx; }
.ui-screen .calendar-icon { position: relative; width: 28rpx; height: 28rpx; border: 2rpx solid #64766b; border-radius: 5rpx; flex: none; }
.ui-screen .calendar-icon::before { content: ''; position: absolute; left: -2rpx; right: -2rpx; top: 7rpx; border-top: 2rpx solid #64766b; }
.ui-screen .date-value { flex: 1; color: var(--text); font-size: 29rpx; font-weight: 550; font-variant-numeric: tabular-nums; }
.ui-screen .row-link { color: var(--text-secondary); font-size: 23rpx; }
.ui-screen .chevron { width: 12rpx; height: 12rpx; flex: none; border-top: 2rpx solid currentColor; border-right: 2rpx solid currentColor; transform: rotate(45deg); color: #849087; margin: 0 4rpx; }
.ui-screen .chevron.down { transform: rotate(135deg); }
.ui-screen .chevron.up { transform: rotate(-45deg); }
.ui-screen .time-range { display: flex; align-items: center; margin-top: 8rpx; padding: 8rpx 12rpx; border-radius: 18rpx; background: var(--surface-muted); }
.ui-screen .time-picker { min-width: 0; flex: 1; }
.ui-screen .time-cell { display: flex; min-height: 140rpx; flex-direction: column; align-items: center; justify-content: center; gap: 6rpx; border-radius: 12rpx; }
.ui-screen .time-label { color: var(--text-secondary); font-size: 23rpx; }
.ui-screen .time-value { color: var(--text); font-size: 48rpx; font-weight: 600; line-height: 1.25; letter-spacing: 1rpx; font-variant-numeric: tabular-nums; }
.ui-screen .time-separator { width: 24rpx; height: 2rpx; background: #aeb9b1; }
.ui-screen .duration-row { display: flex; align-items: center; gap: 12rpx; margin-top: 20rpx; }
.ui-screen .duration-row > text { flex: none; margin-right: 6rpx; }
.ui-screen .edit-page .duration-chip { display: flex; min-width: 0; flex: 1; align-items: center; justify-content: center; min-height: 64rpx; margin: 0; padding: 0 10rpx; border: 1rpx solid var(--line); border-radius: 10rpx; background: #fff; color: var(--text-secondary); font-size: 23rpx; line-height: 1.3; }
.ui-screen .edit-page .duration-chip.active { border-color: #bed3c5; color: var(--brand); background: var(--brand-faint); }
.ui-screen .edit-page .text-action { display: flex; align-items: center; justify-content: center; gap: 12rpx; min-height: 64rpx; padding: 0 2rpx 0 18rpx; color: var(--brand); font-size: 24rpx; }
.ui-screen .selected-venue { display: flex; align-items: flex-start; gap: 20rpx; padding: 8rpx 0 22rpx; }
.ui-screen .venue-marker { display: flex; width: 68rpx; height: 68rpx; flex: none; align-items: center; justify-content: center; border-radius: 16rpx; background: var(--brand-faint); }
.ui-screen .venue-marker > view { position: relative; width: 23rpx; height: 29rpx; border: 2rpx solid var(--brand); border-radius: 12rpx 12rpx 13rpx 13rpx; }
.ui-screen .venue-marker > view::after { content: ''; position: absolute; width: 7rpx; height: 7rpx; top: 6rpx; left: 6rpx; border: 2rpx solid var(--brand); border-radius: 50%; }
.ui-screen .venue-copy, .ui-screen .venue-result-copy { min-width: 0; flex: 1; }
.ui-screen .selected-venue-name { display: block; color: var(--text); font-size: 30rpx; font-weight: 600; line-height: 1.4; word-break: break-all; }
.ui-screen .selected-venue-address { display: block; margin-top: 8rpx; color: var(--text-secondary); font-size: 23rpx; line-height: 1.6; word-break: break-all; }
.ui-screen .venue-picker-panel { margin: 4rpx 0 18rpx; padding: 18rpx; border: 1rpx solid var(--line); border-radius: 16rpx; }
.ui-screen .venue-search-row { display: flex; align-items: center; overflow: hidden; min-height: 80rpx; border-radius: 12rpx; background: var(--surface-muted); }
.ui-screen .venue-search-row input { flex: 1; min-width: 0; height: 80rpx; padding: 0 18rpx; color: var(--text); font-size: 25rpx; }
.ui-screen .edit-page .venue-search-action { display: flex; width: 80rpx; min-height: 52rpx; flex: none; align-items: center; justify-content: center; border-left: 1rpx solid #d6ddd7; border-radius: 0; }
.ui-screen .search-icon { width: 24rpx; height: 24rpx; position: relative; border: 3rpx solid var(--brand); border-radius: 50%; margin: -5rpx 5rpx 0 0; }
.ui-screen .search-icon::after { content: ''; position: absolute; bottom: -8rpx; right: -6rpx; width: 11rpx; height: 3rpx; border-radius: 2rpx; background: var(--brand); transform: rotate(45deg); }
.ui-screen .edit-page .venue-result-row { display: flex; width: 100%; min-height: 94rpx; align-items: center; justify-content: space-between; gap: 16rpx; margin: 0; padding: 18rpx 12rpx; border-bottom: 1rpx solid var(--line); border-radius: 0; text-align: left; }
.ui-screen .venue-result-row.selected { background: var(--brand-faint); }
.ui-screen .venue-result-name { display: block; color: var(--text); font-size: 25rpx; line-height: 1.5; word-break: break-all; }
.ui-screen .venue-result-address { display: block; margin-top: 6rpx; color: var(--text-secondary); font-size: 21rpx; line-height: 1.5; word-break: break-all; }
.ui-screen .venue-result-action { flex: none; color: var(--brand); font-size: 22rpx; }
.ui-screen .venue-search-empty { padding: 28rpx 10rpx; color: var(--text-secondary); font-size: 23rpx; line-height: 1.6; text-align: center; }
.ui-screen .picker-more { display: flex; align-items: center; justify-content: center; gap: 16rpx; min-height: 72rpx; color: var(--brand); font-size: 23rpx; }
.ui-screen .select-row { display: flex; align-items: center; justify-content: space-between; gap: 20rpx; min-height: 94rpx; }
.ui-screen .row-label { flex: none; color: var(--text-secondary); font-size: 25rpx; }
.ui-screen .row-value { display: flex; align-items: center; justify-content: flex-end; gap: 16rpx; color: var(--text); font-size: 25rpx; text-align: right; }
.ui-screen .field-heading { margin: 12rpx 0 16rpx; }
.ui-screen .segment-row { display: flex; align-items: stretch; gap: 16rpx; }
.ui-screen .edit-page .segment { display: flex; flex: 1; min-width: 0; min-height: 84rpx; align-items: center; justify-content: center; margin: 0; padding: 14rpx 12rpx; border: 1rpx solid var(--line); border-radius: 12rpx; background: #fff; color: var(--text-secondary); font-size: 26rpx; line-height: 1.4; text-align: center; }
.ui-screen .edit-page .segment.active { border-color: #8faf9b; background: var(--brand-soft); color: var(--brand); font-weight: 600; }
.ui-screen .edit-page .segment[disabled] { border-color: var(--line); background: var(--surface-muted); color: var(--text-tertiary); }
.ui-screen .inline-notice { margin-top: 18rpx; padding: 16rpx 18rpx; border-radius: 10rpx; background: #faf6eb; color: #836b38; font-size: 22rpx; line-height: 1.6; }
.ui-screen .capacity-display { display: flex; align-items: baseline; justify-content: center; gap: 8rpx; margin-top: 24rpx; color: var(--text); }
.ui-screen .capacity-number { font-size: 64rpx; font-weight: 600; line-height: 1.1; font-variant-numeric: tabular-nums; }
.ui-screen .capacity-unit { color: var(--text-secondary); font-size: 25rpx; }
.ui-screen .capacity-caption { margin-top: 10rpx; color: var(--text-tertiary); font-size: 22rpx; text-align: center; }
.ui-screen .capacity-slider { margin: 26rpx 10rpx 8rpx; }
.ui-screen .slider-labels { display: flex; justify-content: space-between; margin-bottom: 28rpx; color: var(--text-tertiary); font-size: 21rpx; }
.ui-screen .edit-page .more-toggle { display: flex; align-items: center; justify-content: space-between; gap: 20rpx; width: 100%; min-height: 72rpx; padding: 0; text-align: left; }
.ui-screen .more-copy { display: flex; flex-direction: column; gap: 8rpx; }
.ui-screen .more-content { margin-top: 28rpx; }
.ui-screen .fee-input { display: flex; align-items: center; gap: 14rpx; min-height: 90rpx; padding: 0 22rpx; border: 1rpx solid var(--line); border-radius: 14rpx; background: #fafbf9; color: var(--text); }
.ui-screen .currency { font-size: 29rpx; }
.ui-screen .fee-input input { flex: 1; min-width: 0; height: 88rpx; font-size: 32rpx; }
.ui-screen .fee-unit { flex: none; color: var(--text-secondary); font-size: 24rpx; }
.ui-screen .note-heading { margin-top: 28rpx; }
.ui-screen .note-input { width: 100%; height: 186rpx; padding: 20rpx 22rpx; border: 1rpx solid var(--line); border-radius: 14rpx; background: #fafbf9; color: var(--text); font-size: 26rpx; line-height: 1.6; }
.ui-screen .save-dock { position: fixed; z-index: 20; right: 0; bottom: 0; left: 0; padding: 20rpx 32rpx calc(20rpx + env(safe-area-inset-bottom)); border-top: 1rpx solid var(--line); background: #fff; }
.ui-screen .save-row { display: flex; align-items: center; gap: 24rpx; }
.ui-screen .save-summary { min-width: 0; flex: 1; }
.ui-screen .save-state { display: block; color: var(--text); font-size: 24rpx; line-height: 1.5; }
.ui-screen .save-caption { display: block; margin-top: 4rpx; color: var(--text-secondary); font-size: 21rpx; line-height: 1.5; }
.ui-screen .edit-page .save-button { display: flex; flex: none; width: 260rpx; min-height: 92rpx; align-items: center; justify-content: center; padding: 12rpx 16rpx; border-radius: 14rpx; background: var(--brand); color: #fff; font-size: 28rpx; font-weight: 600; line-height: 1.3; }
.ui-screen .edit-page .save-button[disabled] { background: #e7ece8; color: #819086; }
.ui-screen .save-error { margin-bottom: 16rpx; color: var(--danger); font-size: 23rpx; line-height: 1.5; }
.ui-screen .edit-state { padding: 140rpx 0; text-align: center; }
.ui-screen .state-title { color: var(--text); font-size: 32rpx; font-weight: 600; }
.ui-screen .state-copy, .ui-screen .loading-copy { display: block; margin: 16rpx auto 26rpx; color: var(--text-secondary); font-size: 25rpx; line-height: 1.6; }
.ui-screen .edit-page .retry-button { display: inline-flex; min-height: 88rpx; align-items: center; justify-content: center; padding: 12rpx 32rpx; border: 1rpx solid var(--line); border-radius: 12rpx; color: var(--brand); font-size: 26rpx; }
.ui-screen .state-skeleton { width: 50%; height: 42rpx; margin: auto; }
.ui-screen .card-skeleton { width: 100%; height: 260rpx; margin-top: 32rpx; }
.ui-screen .row-press, .ui-screen .button-press { opacity: .7; }
