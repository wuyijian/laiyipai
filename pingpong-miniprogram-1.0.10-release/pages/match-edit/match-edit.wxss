.edit-page { min-height: 100vh; box-sizing: border-box; padding: 24rpx 32rpx calc(150rpx + env(safe-area-inset-bottom)); background: #f6f7f5; }
.edit-heading { padding: 8rpx 4rpx 24rpx; }
.edit-title { color: var(--text); font-size: 42rpx; font-weight: 650; letter-spacing: -1rpx; }
.edit-copy { margin-top: 10rpx; color: var(--text-secondary); font-size: 22rpx; line-height: 1.6; }
.edit-card { margin-bottom: 18rpx; padding: 24rpx; border: 1rpx solid var(--line); border-radius: 20rpx; background: #fff; }
.section-label { margin-bottom: 18rpx; color: var(--text); font-size: 25rpx; font-weight: 620; }
.field { display: flex; min-height: 84rpx; align-items: center; justify-content: space-between; gap: 20rpx; color: var(--text-secondary); font-size: 23rpx; }
.field input { min-width: 0; flex: 1; color: var(--text); font-size: 25rpx; text-align: right; }
.schedule-row { display: grid; grid-template-columns: 1.2fr 1fr 1fr; gap: 10rpx; }
.schedule-row picker view { display: flex; min-height: 88rpx; flex-direction: column; justify-content: center; gap: 5rpx; padding: 0 16rpx; border-radius: 13rpx; background: var(--surface-muted); }
.schedule-row picker text:first-child { color: var(--text-tertiary); font-size: 19rpx; }
.schedule-row picker text:last-child { color: var(--text); font-size: 24rpx; font-weight: 600; }
.venue-warning, .court-reset-notice { margin-bottom: 14rpx; padding: 16rpx 18rpx; border-radius: 12rpx; background: #faf6e9; color: #836b38; font-size: 21rpx; line-height: 1.55; }
.court-reset-notice { margin: 14rpx 0 0; }
.venue-search-row { display: flex; align-items: center; gap: 12rpx; margin-bottom: 12rpx; }
.venue-search-row input { min-width: 0; flex: 1; height: 76rpx; box-sizing: border-box; padding: 0 18rpx; border-radius: 13rpx; background: var(--surface-muted); color: var(--text); font-size: 24rpx; }
.venue-search-action { display: flex; width: auto; min-height: 76rpx; flex: none; align-items: center; margin: 0; padding: 0 24rpx; border: 1rpx solid var(--line); border-radius: 13rpx; background: #fff; color: var(--brand); font-size: 23rpx; font-weight: 600; }
.venue-search-empty { padding: 22rpx 16rpx; border-radius: 13rpx; background: var(--surface-muted); color: var(--text-secondary); font-size: 22rpx; text-align: center; }
.venue-result-list { overflow: hidden; border: 1rpx solid var(--line); border-radius: 13rpx; background: #fff; }
.venue-result-row { display: flex; width: 100%; min-height: 82rpx; align-items: center; justify-content: space-between; gap: 16rpx; margin: 0; padding: 13rpx 17rpx; border-bottom: 1rpx solid var(--line); border-radius: 0; background: #fff; color: var(--brand); font-size: 22rpx; text-align: left; }
.venue-result-row::after { display: none; }
.venue-result-row.selected { background: var(--brand-soft); }
.venue-result-row.unavailable { color: var(--text-tertiary); }
.venue-result-row > view { min-width: 0; flex: 1; }
.venue-result-name { display: block; color: var(--text); font-size: 24rpx; font-weight: 600; }
.venue-result-address { display: block; overflow: hidden; margin-top: 4rpx; color: var(--text-secondary); font-size: 20rpx; text-overflow: ellipsis; white-space: nowrap; }
.venue-result-hint { display: block; padding: 11rpx 16rpx; color: var(--text-secondary); font-size: 20rpx; text-align: center; }
.select-row, .capacity-head { display: flex; min-height: 78rpx; align-items: center; justify-content: space-between; gap: 20rpx; color: var(--text-secondary); font-size: 23rpx; }
.select-row text:last-child, .capacity-head text:last-child { color: var(--text); font-weight: 600; }
.segment-row, .intent-row { display: grid; grid-template-columns: 1fr 1fr; gap: 12rpx; margin-top: 12rpx; }
.segment { display: flex; min-height: 76rpx; align-items: center; justify-content: center; margin: 0; padding: 0 14rpx; border: 1rpx solid var(--line); border-radius: 13rpx; background: #fff; color: var(--text-secondary); font-size: 23rpx; line-height: 1.3; }
.segment.active { border-color: var(--brand); background: var(--brand-soft); color: var(--brand); font-weight: 600; }
.segment[disabled] { border-color: var(--line); background: #f2f3f0; color: var(--text-tertiary); }
.inline-input { display: flex; flex: 1; align-items: center; justify-content: flex-end; gap: 6rpx; color: var(--text); }
.inline-input input { max-width: 180rpx; }
.save-error { margin: 12rpx 4rpx; color: #b24336; font-size: 22rpx; text-align: center; }
.save-dock { position: fixed; z-index: 20; right: 0; bottom: 0; left: 0; padding: 18rpx 32rpx calc(18rpx + env(safe-area-inset-bottom)); border-top: 1rpx solid var(--line); background: rgba(255,255,255,.96); }
.save-dock button { display: flex; min-height: 88rpx; align-items: center; justify-content: center; border-radius: 15rpx; background: var(--brand); color: #fff; font-size: 27rpx; font-weight: 620; }
.save-dock button[disabled] { background: #dfe4dc; color: var(--text-secondary); }
.edit-state { padding: 160rpx 20rpx; text-align: center; }
.state-title { color: var(--text); font-size: 28rpx; font-weight: 620; }
.state-copy { margin: 14rpx auto 24rpx; color: var(--text-secondary); font-size: 23rpx; }
.edit-state button { display: inline-flex; width: auto; min-height: 76rpx; align-items: center; padding: 0 28rpx; border: 1rpx solid var(--line); border-radius: 14rpx; color: var(--brand); }
.state-skeleton { width: 46%; height: 38rpx; }
.card-skeleton { width: 100%; height: 260rpx; margin-top: 28rpx; }
