.ui-screen .directory-header { display:flex; justify-content:space-between; align-items:center; gap:20rpx; margin:20rpx 0 32rpx; }
.ui-screen .directory-title { font-size:38rpx; font-weight:700; }
.ui-screen .directory-copy { margin-top:12rpx; color:var(--text-secondary); font-size:23rpx; line-height:1.6; }
.ui-screen .status-link { color:#0f5c45; font-size:25rpx; flex-shrink:0; }
.ui-screen .directory-filters { display:flex; gap:12rpx; }
.ui-screen .directory-filters picker { flex:1; min-width:0; background:#f2f5f3; border-radius:16rpx; padding:22rpx 6rpx; font-size:23rpx; text-align:center; }
.ui-screen .directory-card { display:block; width:100%; text-align:left; padding:28rpx 0; border-bottom:1rpx solid var(--line); border-radius:0; }
.ui-screen .card-header { display:flex; gap:20rpx; align-items:center; }
.ui-screen .card-person { flex:1; min-width:0; }
.ui-screen .card-name { font-size:30rpx; font-weight:600; overflow-wrap:anywhere; }
.ui-screen .card-meta { font-size:23rpx; color:var(--text-secondary); margin-top:8rpx; }
.ui-screen .availability-badge { font-size:21rpx; padding:8rpx 14rpx; border-radius:12rpx; background:#f1f3f2; color:#6c756f; flex-shrink:0; }
.ui-screen .availability-badge.available { background:#e6f4eb; color:#0f5c45; }
.ui-screen .card-traits { display:flex; gap:12rpx; flex-wrap:wrap; margin-top:18rpx; }
.ui-screen .card-traits text { font-size:22rpx; background:#f5f6f4; padding:5rpx 12rpx; border-radius:8rpx; }
.ui-screen .availability-plan { margin-top:18rpx; padding:18rpx; border-radius:14rpx; background:#f0f6f2; color:#0f5c45; font-size:25rpx; line-height:1.8; }
.ui-screen .card-note { margin-top:16rpx; font-size:25rpx; line-height:1.6; color:var(--text-secondary); white-space:pre-wrap; overflow-wrap:anywhere; }
