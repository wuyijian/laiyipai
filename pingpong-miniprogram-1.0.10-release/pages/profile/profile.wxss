.ui-screen .section-action-quiet { background: #fff; color: var(--brand); border: 1rpx solid var(--line); }

.ui-screen .venue-submissions-section { padding-bottom: 10rpx; }
.ui-screen .venue-submission-list { margin: 4rpx -8rpx 0; }
.ui-screen .venue-submission-row { display: flex; min-height: 104rpx; padding: 18rpx 8rpx; align-items: center; gap: 16rpx; border-top: 1rpx solid var(--line); }
.ui-screen .venue-submission-row:first-child { border-top: 0; }
.ui-screen .venue-submission-copy { flex: 1; min-width: 0; }
.ui-screen .venue-submission-title-row { display: flex; align-items: center; gap: 12rpx; }
.ui-screen .venue-submission-name { min-width: 0; flex: 1; overflow: hidden; color: var(--profile-ink); font-size: 25rpx; font-weight: 600; text-overflow: ellipsis; white-space: nowrap; }
.ui-screen .venue-submission-status { flex: none; padding: 6rpx 11rpx; border-radius: 999rpx; background: #f2eadc; color: #846f45; font-size: 19rpx; font-weight: 600; line-height: 1.2; }
.ui-screen .venue-submission-status.status-approved { background: #e4f0ea; color: var(--brand); }
.ui-screen .venue-submission-status.status-rejected { background: #f5e5e2; color: var(--danger); }
.ui-screen .venue-submission-caption { display: -webkit-box; overflow: hidden; margin-top: 7rpx; color: var(--profile-muted); font-size: 21rpx; line-height: 1.45; -webkit-box-orient: vertical; -webkit-line-clamp: 2; }
.ui-screen .venue-submission-empty { padding-top: 24rpx; padding-bottom: 28rpx; }

.ui-screen .admin-review-row { display: flex; width: 100%; min-height: 104rpx; align-items: center; gap: 16rpx; margin-top: 30rpx; padding: 14rpx 4rpx; border-top: 1rpx solid var(--line); border-bottom: 1rpx solid var(--line); background: #fff; text-align: left; }
.ui-screen .admin-review-mark { display: flex; flex: 0 0 68rpx; width: 68rpx; height: 52rpx; align-items: center; justify-content: center; border-radius: 11rpx; background: var(--brand-soft); color: var(--brand); font-size: 20rpx; font-weight: 650; letter-spacing: 1rpx; }
.ui-screen .admin-review-copy { display: flex; min-width: 0; flex: 1; flex-direction: column; }
.ui-screen .admin-review-title { color: var(--profile-ink); font-size: 27rpx; font-weight: 650; }
.ui-screen .admin-review-subtitle { margin-top: 5rpx; color: var(--profile-muted); font-size: 22rpx; }

.ui-screen .profile-editor-tabs { display: flex; gap: 8rpx; margin: 26rpx 0 10rpx; padding: 8rpx; background: #f3f5f2; border-radius: 16rpx; }
.ui-screen .profile-editor-tab { flex: 1; min-width: 0; min-height: 72rpx; padding: 12rpx 4rpx; display: flex; justify-content: center; align-items: center; font-size: 24rpx; color: #69756d; border-radius: 12rpx; }
.ui-screen .profile-editor-tab.active { color: #0f5c45; background: white; font-weight: 600; }
.ui-screen .editor-note { margin-top: 12rpx; font-size: 23rpx; line-height: 1.65; color: #758178; }
.ui-screen .editor-help-button { margin-top: 18rpx; padding: 12rpx 0; min-height: 64rpx; color: #0f5c45; font-size: 24rpx; text-align: left; }
.ui-screen .level-preview { padding: 26rpx; margin-top: 20rpx; border-radius: 18rpx; background: #f0f6f1; }
.ui-screen .level-preview-caption { font-size: 24rpx; color: #6a786e; }
.ui-screen .level-preview-value { font-size: 40rpx; font-weight: 700; color: #174c32; margin-top: 12rpx; }
.ui-screen .level-guide-row { display: flex; justify-content: space-between; gap: 20rpx; padding: 16rpx 0; border-bottom: 1rpx solid #dfe8e0; font-size: 24rpx; }
.ui-screen .trait-group { margin-top: 28rpx; }
.ui-screen .trait-choices { display: flex; flex-wrap: wrap; gap: 14rpx; margin-top: 16rpx; }
.ui-screen .trait-choice { margin: 0; min-height: 72rpx; padding: 16rpx 20rpx; border: 1rpx solid #e1e6df; border-radius: 14rpx; font-size: 25rpx; color: #5a6b60; }
.ui-screen .trait-choice.selected { background: #e9f3ec; border-color: #8cb59a; color: #145935; }
.ui-screen .ability-category { margin-top: 24rpx; padding: 22rpx; background: #eff5f0; border-radius: 14rpx; color: #245e42; display: flex; justify-content: space-between; font-size: 26rpx; }
.ui-screen .ability-edit-row { padding: 22rpx 0; border-bottom: 1rpx solid #eef0ec; }
.ui-screen .ability-value-row { display: flex; justify-content: space-between; align-items: center; min-height: 60rpx; gap: 20rpx; font-size: 27rpx; }
.ui-screen .ability-state { color: #0f5c45; font-size: 25rpx; }
.ui-screen .ability-state.state-0 { color: #88918a; }

.ui-screen .feedback-entry { width: 100%; display: flex; align-items: center; justify-content: space-between; gap: 20rpx; margin-top: 24rpx; padding: 26rpx 4rpx; text-align: left; border-top: 1rpx solid var(--line); }
.ui-screen .feedback-entry-copy { display: flex; flex-direction: column; gap: 8rpx; }
.ui-screen .feedback-title { font-size: 28rpx; font-weight: 600; }
.ui-screen .feedback-subtitle { font-size: 23rpx; color: var(--text-secondary); line-height: 1.6; }
.ui-screen .auto-level-summary { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; margin: 18rpx 0; padding: 20rpx; border-radius: 14rpx; background: #edf5ef; font-size: 23rpx; }
.ui-screen .auto-level-code { margin-left: 14rpx; color: #0f5c45; font-size: 28rpx; font-weight: 600; }
.ui-screen .assessment-checklist { display: flex; flex-wrap: wrap; gap: 10rpx; margin-top: 18rpx; }
.ui-screen .assessment-checklist text { padding: 6rpx 12rpx; background: #f4f5f3; border-radius: 8rpx; font-size: 22rpx; color: #6b746d; }
.ui-screen .assessment-checklist text.complete { color: #0f5c45; background: #edf5ef; }
