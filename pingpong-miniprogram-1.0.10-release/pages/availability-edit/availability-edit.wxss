.ui-screen .availability-title { font-size:38rpx; font-weight:700; margin-top:24rpx; }
.ui-screen .availability-copy { color:var(--text-secondary); font-size:24rpx; line-height:1.7; margin-top:10rpx; }
.ui-screen .availability-switch { display:flex; justify-content:space-between; align-items:center; gap:20rpx; margin:32rpx 0; padding:26rpx; border-radius:20rpx; background:#eff6f1; font-size:30rpx; }
.ui-screen .field-label { margin:28rpx 0 14rpx; font-size:27rpx; font-weight:600; }
.ui-screen .status-note { box-sizing:border-box; width:100%; height:180rpx; padding:22rpx; font-size:28rpx; background:#f5f7f5; border-radius:16rpx; }
.ui-screen .field-picker { padding:24rpx; border-radius:16rpx; background:#f5f7f5; font-size:28rpx; }
.ui-screen .time-row { display:flex; gap:24rpx; }
.ui-screen .time-row > view { flex:1; }
.ui-screen .selected-venue { padding:20rpx; background:#e5f3e9; border-radius:14rpx; color:#0f5c45; font-size:27rpx; }
.ui-screen .venue-search { display:flex; align-items:center; gap:16rpx; margin-top:20rpx; }
.ui-screen .venue-search input { flex:1; min-width:0; background:#f5f7f5; padding:20rpx; border-radius:14rpx; font-size:26rpx; }
.ui-screen .venue-search button { font-size:26rpx; color:#0f5c45; }
.ui-screen .venue-results { max-height:520rpx; overflow-y:auto; }
.ui-screen .venue-option { display:block; width:100%; padding:22rpx 12rpx; text-align:left; font-size:26rpx; border-bottom:1rpx solid var(--line); border-radius:0; }
.ui-screen .venue-option.selected { color:#0f5c45; background:#f0f7f2; }
.ui-screen .save-area { position:sticky; bottom:0; padding:24rpx 0; background:#fff; }

.ui-screen .nearby-sharing { margin-top: 24rpx; padding: 4rpx 24rpx 16rpx; background: #f5f7f5; border-radius: 16rpx; }
