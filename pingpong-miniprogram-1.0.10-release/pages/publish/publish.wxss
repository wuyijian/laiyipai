.ui-screen .publish-error { display: flex; align-items: flex-start; gap: 12rpx; margin: 5rpx 0 0; padding: 18rpx 20rpx; border-radius: 15rpx; background: #fff0ec; color: #9d3424; line-height: 1.45; font-size: 24rpx; }
.ui-screen .error-mark { display: flex; width: 30rpx; height: 30rpx; flex: none; align-items: center; justify-content: center; border: 1rpx solid currentColor; border-radius: 50%; font-size: 18rpx; font-weight: 700; }
.ui-screen .submit-dock { position: fixed; z-index: 20; right: 0; bottom: calc(102rpx + env(safe-area-inset-bottom)); left: 0; display: flex; align-items: center; border-top: 1rpx solid rgba(23, 27, 24, .08); gap: 18rpx; padding: 18rpx 32rpx; background: rgba(255, 255, 255, .98); box-shadow: none; }
.ui-screen .dock-summary { display: flex; min-width: 0; flex: 1; flex-direction: column; }
.ui-screen .dock-label { color: #9a9f9b; font-size: 17rpx; font-weight: 600; letter-spacing: 1rpx; line-height: 1.3; }
.ui-screen .dock-date { overflow: hidden; margin-top: 3rpx; color: var(--ink); font-weight: 650; font-variant-numeric: tabular-nums; line-height: 1.3; text-overflow: ellipsis; white-space: nowrap; font-size: 25rpx; }
.ui-screen .dock-meta { overflow: hidden; margin-top: 3rpx; line-height: 1.3; text-overflow: ellipsis; white-space: nowrap; font-size: 21rpx; color: var(--text-secondary); }
.ui-screen .publish-submit { display: flex; align-items: center; justify-content: center; font-weight: 700; line-height: 1; text-align: center; transition: opacity .12s ease, transform .12s ease, background-color .16s ease; width: 210rpx; flex: 0 0 210rpx; min-height: 88rpx; margin: 0; background: var(--brand); color: #fff; box-shadow: none; font-size: 27rpx; border-radius: 14rpx; }
.ui-screen .publish-submit[disabled] { background: #e2e6e1; color: #9aa09b; box-shadow: none; }
.ui-screen .success-page { max-width: 690rpx; margin: 0 auto; padding: 80rpx 4rpx 24rpx; text-align: center; }
.ui-screen .success-mark { position: relative; display: flex; width: 104rpx; height: 104rpx; align-items: center; justify-content: center; margin: 0 auto; border-radius: 50%; background: var(--brand-soft); }
.ui-screen .success-check { width: 35rpx; height: 19rpx; border-bottom: 6rpx solid var(--ink); border-left: 6rpx solid var(--ink); transform: translateY(-4rpx) rotate(-45deg); border-color: var(--brand); }
.ui-screen .success-kicker { margin-top: 26rpx; color: var(--green); font-size: 21rpx; font-weight: 650; letter-spacing: 3rpx; }
.ui-screen .success-title { margin-top: 10rpx; color: var(--ink); font-size: 40rpx; font-weight: 700; letter-spacing: -1rpx; line-height: 1.25; }
.ui-screen .success-caption { margin-top: 10rpx; color: #7c837d; font-size: 23rpx; line-height: 1.5; }
.ui-screen .match-ticket { margin: 31rpx 0 28rpx; padding: 28rpx; background: #fff; text-align: left; box-shadow: none; border: 1rpx solid var(--line); border-radius: 18rpx; }
.ui-screen .ticket-topline { display: flex; align-items: center; justify-content: space-between; }
.ui-screen .ticket-intent { display: inline-flex; min-height: 44rpx; align-items: center; padding: 0 15rpx; border-radius: 9rpx; font-size: 20rpx; font-weight: 650; background: var(--brand-soft); color: var(--brand); }
.ui-screen .ticket-capacity { color: #707771; font-size: 22rpx; font-weight: 600; }
.ui-screen .ticket-title { margin-top: 21rpx; color: var(--ink); font-size: 34rpx; font-weight: 700; line-height: 1.3; }
.ui-screen .ticket-schedule { margin-top: 19rpx; color: var(--ink); font-size: 27rpx; font-weight: 650; font-variant-numeric: tabular-nums; line-height: 1.4; }
.ui-screen .ticket-venue { margin-top: 7rpx; color: #777e78; font-size: 23rpx; line-height: 1.45; }
.ui-screen .ticket-rule { height: 1rpx; margin: 24rpx 0 19rpx; background: var(--line); }
.ui-screen .ticket-status { display: flex; align-items: center; color: #717872; font-size: 21rpx; }
.ui-screen .status-pulse { width: 12rpx; height: 12rpx; margin-right: 9rpx; border-radius: 50%; background: var(--accent-deep); }
.ui-screen .success-primary { display: flex; align-items: center; justify-content: center; border-radius: 17rpx; line-height: 1; background: var(--brand); width: 100%; }
.ui-screen .success-page .text-button { display: flex; align-items: center; justify-content: center; line-height: 1; }

.ui-screen .setting-label, .ui-screen .field-label { font-size: 25rpx; font-weight: 550; }
.ui-screen .intent-option.active .intent-select, .ui-screen .wide-segment.active .segment-radio { border-color: var(--brand); background: var(--brand); }
.ui-screen .intent-option.active .intent-select-dot, .ui-screen .wide-segment.active .segment-radio-dot { background: #fff; }
.ui-screen .intent-name, .ui-screen .segment-title { font-size: 25rpx; font-weight: 550; }
.ui-screen .intent-caption, .ui-screen .segment-caption { font-size: 21rpx; color: var(--text-secondary); }
.ui-screen .text-input, .ui-screen .note-input { font-size: 26rpx; }
.ui-screen .submit-dock { flex-wrap: wrap; }
.ui-screen .dock-error { flex: 0 0 100%; width: 100%; padding: 12rpx 16rpx; border-radius: 10rpx; background: #fff1f0; color: var(--danger); font-size: 23rpx; line-height: 1.5; }
.ui-screen .venue-create-link { display: flex; justify-content: space-between; align-items: center; gap: 14rpx; min-height: 80rpx; padding: 12rpx 0; width: 100%; margin: 6rpx 0 0; background: transparent; font-size: 23rpx; color: var(--text-secondary); line-height: 1.4; }
.ui-screen .venue-create-link text:last-child { color: var(--brand); font-weight: 500; flex: none; }
.ui-screen .venue-source-note { color: var(--text-secondary); font-size: 21rpx; line-height: 1.6; margin-bottom: 12rpx; }
.ui-screen .publish-locked .form-surface, .ui-screen .publish-locked .more-card, .ui-screen .publish-locked .terms-row { pointer-events: none; opacity: .62; }
