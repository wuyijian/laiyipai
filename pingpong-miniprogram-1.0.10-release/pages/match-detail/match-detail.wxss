page { background: #fff; }
.ui-screen .detail-page { min-height: 100vh; padding: 0 36rpx calc(224rpx + env(safe-area-inset-bottom)); color: var(--text); padding-left: 32rpx; padding-right: 32rpx; }
.ui-screen .detail-loading { padding-top: 30rpx; }
.ui-screen .hero-skeleton { height: 300rpx; }
.ui-screen .block-skeleton { height: 210rpx; margin-top: 28rpx; }
.ui-screen .detail-hero { padding: 24rpx 0 30rpx; }
.ui-screen .hero-topline, .ui-screen .section-heading, .ui-screen .bottom-main, .ui-screen .sheet-head { display: flex; align-items: center; justify-content: space-between; }
.ui-screen .hero-actions { display: flex; align-items: center; gap: 20rpx; }
.ui-screen .status-tag { display: inline-flex; align-items: center; gap: 10rpx; color: var(--text-secondary); font-size: 23rpx; font-weight: 500; }
.ui-screen .status-dot { width: 10rpx; height: 10rpx; border-radius: 50%; background: #477952; }
.ui-screen .status-cancelled, .ui-screen .status-completed { color: var(--text-secondary); }
.ui-screen .status-cancelled .status-dot, .ui-screen .status-completed .status-dot { background: #a8aea8; }
.ui-screen .status-changed { color: #937035; }
.ui-screen .status-changed .status-dot { background: #ac8a45; }
.ui-screen .share-button { display: flex; width: auto; min-height: 64rpx; padding: 0 0 0 20rpx; align-items: center; justify-content: center; gap: 10rpx; font-size: 23rpx; color: var(--text-secondary); margin: 0; }
.ui-screen .share-arrow { font-size: 30rpx; }
.ui-screen .detail-title { margin-top: 18rpx; line-height: 1.4; letter-spacing: -.8rpx; overflow-wrap: anywhere; font-weight: 650; font-size: 40rpx; }
.ui-screen .intent-tags { display: flex; flex-wrap: wrap; gap: 10rpx; margin-top: 18rpx; }
.ui-screen .intent-tags text { padding: 8rpx 15rpx; border-radius: 8rpx; background: #f2f4ef; color: var(--text-secondary); font-size: 23rpx; line-height: 1.4; }
.ui-screen .intent-tags text:first-child { background: var(--brand-soft); color: var(--brand); }
.ui-screen .schedule-block { position: relative; padding: 28rpx 0 0; }
.ui-screen .schedule-date { font-size: 26rpx; font-weight: 500; color: var(--text-secondary); }
.ui-screen .schedule-time { display: flex; align-items: baseline; gap: 16rpx; margin-top: 12rpx; font-weight: 650; letter-spacing: -1.4rpx; font-variant-numeric: tabular-nums; font-size: 48rpx; }
.ui-screen .time-dash { color: var(--text-secondary); font-size: 34rpx; font-weight: 400; }
.ui-screen .schedule-duration { margin-top: 10rpx; color: var(--text-secondary); font-size: 23rpx; }
.ui-screen .detail-section { padding: 30rpx 0; border-top: 1rpx solid #e9ece5; }
.ui-screen .section-heading { margin-bottom: 24rpx; font-size: 30rpx; font-weight: 650; }
.ui-screen .venue-main-row { display: flex; align-items: center; gap: 18rpx; }
.ui-screen .venue-main { display: flex; align-items: center; flex: 1; min-width: 0; gap: 18rpx; }
.ui-screen .venue-copy { flex: 1; min-width: 0; }
.ui-screen .venue-name { font-size: 28rpx; font-weight: 600; line-height: 1.5; overflow-wrap: anywhere; }
.ui-screen .venue-address { display: flex; width: 100%; min-height: 54rpx; margin: 3rpx 0 0; padding: 0; align-items: center; justify-content: space-between; gap: 14rpx; color: var(--text-secondary); font-size: 22rpx; line-height: 1.5; text-align: left; }
.ui-screen .venue-address > text:first-child { min-width: 0; flex: 1; }
.ui-screen .venue-address-action { flex: none; color: var(--brand); font-size: 20rpx; white-space: nowrap; }
.ui-screen .venue-activity-tags { display: flex; flex-wrap: wrap; gap: 12rpx; margin-top: 8rpx; color: var(--text-secondary); font-size: 21rpx; }
.ui-screen .row-chevron { color: var(--text-secondary); font-size: 32rpx; }
.ui-screen .venue-mark { display: flex; flex: 0 0 90rpx; width: 90rpx; min-width: 90rpx; max-width: 90rpx; min-height: 86rpx; flex-direction: column; align-items: center; justify-content: center; gap: 10rpx; margin: 0 0 0 4rpx; border-left: 1rpx solid #e9ece5; font-size: 20rpx; color: var(--text-secondary); }
.ui-screen .bookmark-icon { width: 22rpx; height: 28rpx; border: 2rpx solid currentColor; border-radius: 3rpx; }
.ui-screen .is-marked { color: var(--text-secondary); }
.ui-screen .is-marked .bookmark-icon { background: #dce8d0; }
.ui-screen .court-note { display: flex; gap: 12rpx; align-items: flex-start; margin-top: 24rpx; padding: 17rpx 20rpx; border-radius: 10rpx; background: #f7f8f4; }
.ui-screen .court-note-dot { width: 9rpx; height: 9rpx; margin-top: 11rpx; flex-shrink: 0; border-radius: 50%; background: #b29a61; }
.ui-screen .court-note-dot.booked { background: #618452; }
.ui-screen .court-note-title { display: block; color: var(--text-secondary); font-size: 23rpx; line-height: 1.5; }
.ui-screen .court-note-caption { display: block; margin-top: 4rpx; color: var(--text-secondary); font-size: 21rpx; line-height: 1.5; }
.ui-screen .seat-count { color: var(--text-secondary); font-size: 24rpx; font-weight: 400; }
.ui-screen .seat-count text { color: var(--text); font-weight: 650; }
.ui-screen .player-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); row-gap: 26rpx; }
.ui-screen .player-slot { min-width: 0; text-align: center; }
.ui-screen .player-slot-button, .ui-screen .empty-slot { display: flex; width: 100%; min-width: 0; align-items: center; flex-direction: column; }
.ui-screen .slot-avatar { position: relative; width: 94rpx; height: 94rpx; }
.ui-screen .host-badge { position: absolute; left: 50%; bottom: -7rpx; transform: translateX(-50%); padding: 3rpx 10rpx; border: 3rpx solid #fff; border-radius: 6rpx; white-space: nowrap; font-size: 19rpx; background: var(--brand-soft); color: var(--brand); }
.ui-screen .slot-name { width: 100%; overflow: hidden; margin-top: 16rpx; padding: 0 6rpx; font-size: 24rpx; line-height: 1.45; text-overflow: ellipsis; white-space: nowrap; }
.ui-screen .slot-age { width: 100%; overflow: hidden; margin-top: 5rpx; padding: 0 3rpx; color: var(--text-secondary); line-height: 1.4; text-overflow: ellipsis; white-space: nowrap; font-size: 21rpx; }
.ui-screen .empty-avatar, .ui-screen .private-avatar { display: flex; width: 94rpx; height: 94rpx; align-items: center; justify-content: center; border: 2rpx dashed #d7dfcd; border-radius: 50%; background: #fafbf6; color: var(--text-secondary); font-size: 35rpx; }
.ui-screen .private-avatar { border-style: solid; font-size: 28rpx; }
.ui-screen .empty-slot .slot-name { color: var(--text-secondary); font-size: 22rpx; }
.ui-screen .seats-caption { margin-top: 24rpx; color: var(--text-secondary); font-size: 22rpx; line-height: 1.5; }
.ui-screen .host-brief { margin-top: 26rpx; padding-top: 22rpx; border-top: 1rpx solid #edf0e7; }
.ui-screen .host-brief-label { color: var(--text-secondary); font-size: 22rpx; }
.ui-screen .host-skills { display: flex; flex-wrap: wrap; gap: 10rpx; margin-top: 14rpx; }
.ui-screen .host-skills text { color: var(--text-secondary); font-size: 23rpx; }
.ui-screen .host-skills text + text::before { content: '·'; margin-right: 10rpx; color: var(--text-secondary); }
.ui-screen .host-rating { margin-top: 8rpx; color: var(--text-secondary); font-size: 21rpx; }
.ui-screen .fact-row { display: flex; justify-content: space-between; gap: 24rpx; padding: 13rpx 0; color: var(--text); font-size: 25rpx; line-height: 1.5; }
.ui-screen .fact-row > text:first-child { color: var(--text-secondary); flex-shrink: 0; }
.ui-screen .fact-row > text:last-child { text-align: right; }
.ui-screen .court-booking-note { margin-top: 20rpx; color: var(--text-secondary); font-size: 21rpx; line-height: 1.6; }
.ui-screen .detail-footnote { padding-top: 8rpx; color: var(--text-secondary); font-size: 21rpx; line-height: 1.6; }
.ui-screen .report-link { display: flex; width: auto; min-height: 70rpx; align-items: center; justify-content: center; margin: 8rpx auto 0; color: var(--text-secondary); font-size: 22rpx; }
.ui-screen .membership-notice { margin-bottom: 24rpx; padding: 22rpx 24rpx; border-radius: 12rpx; background: #f3f6ec; }
.ui-screen .communication-card { display: flex; width: 100%; min-height: 116rpx; margin: 0 0 28rpx; padding: 20rpx 22rpx; align-items: center; gap: 18rpx; border: 1rpx solid #cddfcf; border-radius: 18rpx; background: #edf6ef; color: var(--text); text-align: left; box-shadow: 0 8rpx 22rpx rgba(28, 76, 52, .07); }
.ui-screen .communication-card-press { background: #e3f0e6; transform: scale(.99); }
.ui-screen .communication-icon { position: relative; display: flex; flex: 0 0 66rpx; width: 66rpx; height: 66rpx; align-items: center; justify-content: center; border-radius: 50%; background: var(--brand); color: #fff; }
.ui-screen .communication-icon view { position: absolute; right: 9rpx; bottom: 7rpx; width: 13rpx; height: 13rpx; background: var(--brand); transform: rotate(38deg); }
.ui-screen .communication-icon text { position: relative; margin-top: -8rpx; font-size: 24rpx; letter-spacing: 1rpx; }
.ui-screen .communication-copy { min-width: 0; flex: 1; }
.ui-screen .communication-title { font-size: 27rpx; font-weight: 650; line-height: 1.4; }
.ui-screen .communication-caption { margin-top: 4rpx; color: var(--text-secondary); font-size: 21rpx; line-height: 1.45; }
.ui-screen .communication-action { display: flex; flex: none; align-items: center; color: var(--brand); font-size: 23rpx; font-weight: 600; white-space: nowrap; }
.ui-screen .communication-action text { margin-left: 5rpx; font-size: 31rpx; font-weight: 400; }
.ui-screen .tone-attention { background: #faf6e9; }
.ui-screen .membership-title { color: var(--text); font-size: 26rpx; font-weight: 550; line-height: 1.5; }
.ui-screen .tone-attention .membership-title { color: #8c703b; }
.ui-screen .membership-copy { margin-top: 7rpx; color: var(--text-secondary); font-size: 23rpx; line-height: 1.6; }
.ui-screen .membership-actions { display: flex; flex-wrap: wrap; gap: 22rpx; margin-top: 10rpx; }
.ui-screen .membership-actions button { display: flex; width: auto; min-height: 60rpx; align-items: center; gap: 12rpx; color: var(--text-secondary); font-size: 23rpx; }
.ui-screen .detail-bottom { position: fixed; z-index: 30; right: 0; bottom: 0; left: 0; padding: 20rpx 36rpx calc(12rpx + env(safe-area-inset-bottom)); border-top: 1rpx solid #e5eadd; background: #fff; padding-left: 32rpx; padding-right: 32rpx; }
.ui-screen .bottom-main { gap: 20rpx; }
.ui-screen .price-copy { display: flex; min-width: 0; flex: 1; flex-direction: column; }
.ui-screen .price-value { font-size: 34rpx; line-height: 1.35; font-weight: 650; letter-spacing: -.6rpx; }
.ui-screen .price-caption { margin-top: 5rpx; color: var(--text-secondary); font-size: 20rpx; line-height: 1.5; }
.ui-screen .join-button { display: flex; width: 340rpx; min-height: 88rpx; flex: 0 0 340rpx; padding: 16rpx 18rpx; align-items: center; justify-content: center; border-radius: 12rpx; background: #254e38; color: #fff; font-size: 28rpx; line-height: 1.4; font-weight: 600; }
.ui-screen .join-button[disabled] { background: #e3e8de; color: var(--text-secondary); }
.ui-screen .bottom-hint { margin-top: 12rpx; color: var(--text-secondary); font-size: 20rpx; line-height: 1.4; text-align: center; }
.ui-screen .soft-press { opacity: .66; }
.ui-screen .primary-press { background: #173d2a; }
.ui-screen .join-sheet, .ui-screen .result-sheet { padding: 20rpx 36rpx calc(20rpx + env(safe-area-inset-bottom)); }
.ui-screen .sheet-head { gap: 20rpx; }
.ui-screen .sheet-close { display: flex; width: 64rpx; height: 64rpx; flex-shrink: 0; align-items: center; justify-content: center; border-radius: 50%; background: #f4f6f0; color: var(--text-secondary); font-size: 36rpx; margin: 0; line-height: 1.4; }
.ui-screen .sheet-title { font-size: 36rpx; line-height: 1.4; color: var(--text); }
.ui-screen .sheet-copy { margin-top: 14rpx; color: var(--text-secondary); font-size: 24rpx; line-height: 1.65; }
.ui-screen .join-summary { margin-top: 26rpx; padding: 25rpx; border: 1rpx solid #e0e7d7; border-radius: 16rpx; background: #fafbf6; }
.ui-screen .summary-date { color: var(--text-secondary); font-size: 24rpx; }
.ui-screen .summary-time { margin-top: 8rpx; font-size: 38rpx; font-weight: 650; color: var(--text); }
.ui-screen .summary-venue { margin-top: 12rpx; color: var(--text-secondary); font-size: 26rpx; line-height: 1.5; }
.ui-screen .summary-facts { display: flex; flex-wrap: wrap; gap: 10rpx; margin-top: 16rpx; }
.ui-screen .summary-facts text { padding: 7rpx 12rpx; border-radius: 8rpx; background: #eef3e7; color: var(--text-secondary); font-size: 21rpx; line-height: 1.4; }
.ui-screen .summary-footer { display: flex; justify-content: space-between; gap: 20rpx; margin-top: 20rpx; padding-top: 17rpx; border-top: 1rpx solid #e5ebdb; color: var(--text-secondary); font-size: 22rpx; }
.ui-screen .summary-footer text:last-child { color: var(--text-secondary); font-weight: 600; }
.ui-screen .join-court-notice { margin-top: 15rpx; color: var(--text-secondary); font-size: 21rpx; line-height: 1.6; }
.ui-screen .submit-agreement { display: flex; min-height: 60rpx; align-items: center; justify-content: center; margin-top: 15rpx; color: var(--text-secondary); font-size: 22rpx; }
.ui-screen .submit-agreement button { display: flex; width: auto; min-height: 60rpx; align-items: center; color: var(--text-secondary); font-size: 22rpx; margin: 0; }
.ui-screen .confirm-join { display: flex; width: 100%; min-height: 88rpx; padding: 18rpx; align-items: center; justify-content: center; margin-top: 10rpx; border-radius: 12rpx; background: #254e38; font-size: 28rpx; line-height: 1.4; }
.ui-screen .sheet-back { width: 100%; color: var(--text-secondary); font-size: 25rpx; }
.ui-screen .result-sheet { text-align: center; }
.ui-screen .result-symbol { display: flex; width: 90rpx; height: 90rpx; align-items: center; justify-content: center; margin: 0 auto 18rpx; border-radius: 50%; background: #e7efce; color: var(--text-secondary); font-size: 44rpx; }
.ui-screen .result-symbol.pending { background: #f2eedc; color: var(--text-secondary); }
.ui-screen .result-label { margin-bottom: 10rpx; color: var(--text-secondary); font-size: 22rpx; }
.ui-screen .result-schedule { margin-top: 24rpx; color: var(--text-secondary); font-size: 25rpx; }
.ui-screen .result-venue { margin-top: 8rpx; color: var(--text-secondary); font-size: 24rpx; }
.ui-screen .result-sheet .sheet-copy { margin-top: 22rpx; text-align: left; }
.ui-screen .result-sheet .confirm-join { margin-top: 26rpx; }

.ui-screen .join-button, .ui-screen .confirm-join { background: var(--brand); margin-left: 0; margin-right: 0; }
.ui-screen .bottom-hint, .ui-screen .price-caption { font-size: 21rpx; }
