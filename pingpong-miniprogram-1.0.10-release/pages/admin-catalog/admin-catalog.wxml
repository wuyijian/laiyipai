<view class="ui-screen">
  <view class="catalog-page">
    <view class="catalog-heading">
      <view>
        <view class="catalog-eyebrow">运营管理</view>
        <view class="catalog-title">球馆与教练</view>
        <view class="catalog-subtitle">删除会立即停止公开展示，历史球局和预约仍会保留。</view>
      </view>
    </view>

    <view class="catalog-tabs" role="tablist">
      <button class="catalog-tab {{type === 'venues' ? 'selected' : ''}}" data-type="venues" bindtap="switchType" disabled="{{removingId}}" aria-selected="{{type === 'venues'}}">球馆</button>
      <button class="catalog-tab {{type === 'coaches' ? 'selected' : ''}}" data-type="coaches" bindtap="switchType" disabled="{{removingId}}" aria-selected="{{type === 'coaches'}}">教练</button>
    </view>
    <picker wx:if="{{type === 'venues'}}" class="district-filter" mode="selector" range="{{districts}}" value="{{districtIndex}}" bindchange="changeDistrictFilter">
      <view class="district-filter-control"><text>区域 · {{districts[districtIndex]}}</text><text>⌄</text></view>
    </picker>

    <view wx:if="{{state === 'loading'}}" class="catalog-list" aria-live="polite">
      <view wx:for="{{skeletonRows}}" wx:key="*this" class="catalog-row skeleton-row">
        <view class="skeleton skeleton-avatar"></view>
        <view class="skeleton-copy"><view class="skeleton skeleton-title"></view><view class="skeleton skeleton-line"></view></view>
      </view>
    </view>

    <view wx:elif="{{state === 'forbidden'}}" class="catalog-state">
      <view class="state-title">没有管理权限</view>
      <view class="state-copy">请使用已配置为运营管理员的微信账号进入。</view>
    </view>

    <view wx:elif="{{state === 'error' && !items.length}}" class="catalog-state">
      <view class="state-title">列表没有加载出来</view>
      <view class="state-copy">{{errorMessage}}</view>
      <button class="state-action" bindtap="retry">重新加载</button>
    </view>

    <block wx:else>
      <view wx:if="{{errorMessage}}" class="catalog-notice">
        <text>{{errorMessage}}</text><button bindtap="retry">重试</button>
      </view>
      <view wx:if="{{removalError}}" class="catalog-notice danger" aria-role="alert">{{removalError}}</view>

      <view wx:if="{{items.length}}" class="catalog-list">
        <view wx:for="{{items}}" wx:key="id" class="catalog-row">
          <venue-avatar wx:if="{{type === 'venues'}}" seed="{{item.avatarSeed}}" size="70" label="{{item.name}}的球馆头像" />
          <player-avatar wx:else src="" seed="{{item.avatarSeed}}" size="70" label="{{item.name}}的头像" />
          <view class="catalog-copy">
            <view class="catalog-name-row"><text class="catalog-name">{{item.name}}</text><text class="catalog-status {{item.active ? 'active' : ''}}">{{item.statusLabel}}</text></view>
            <text class="catalog-meta">{{item.subtitle}}</text>
          </view>
          <button wx:if="{{type === 'venues'}}" class="edit-action" data-id="{{item.id}}" bindtap="openVenueEditor" disabled="{{removingId}}" aria-label="编辑并认证{{item.name}}">资料认证</button>
          <button class="delete-action" data-id="{{item.id}}" bindtap="requestRemove" loading="{{removingId === item.id}}" disabled="{{removingId}}" aria-label="删除{{item.name}}">删除</button>
        </view>
      </view>

      <view wx:else class="catalog-state compact-state">
        <view class="state-title">暂无{{type === 'venues' ? '球馆' : '教练'}}</view>
        <view class="state-copy">当前没有可管理的记录。</view>
      </view>

      <button wx:if="{{hasMore}}" class="load-more" bindtap="onReachBottom" loading="{{loadingMore}}" disabled="{{loadingMore}}">{{loadingMore ? '加载中' : '加载更多'}}</button>
    </block>
  </view>

  <view wx:if="{{editorVisible}}" class="sheet-mask" catchtap="closeVenueEditor">
    <view class="sheet venue-editor" catchtap="noop" role="dialog" aria-modal="true" aria-label="编辑球馆资料">
      <view class="sheet-handle"></view>
      <view class="editor-head"><view><view class="sheet-title">球馆资料与认证</view><view class="sheet-copy">核对名称和地址后认证，不代表已预订球台。</view></view><button class="editor-close" bindtap="closeVenueEditor" disabled="{{saving}}">×</button></view>
      <scroll-view class="editor-scroll" scroll-y="true">
        <view class="editor-field"><text>名称</text><input value="{{editForm.name}}" maxlength="60" data-field="name" bindinput="changeEditField" /></view>
        <view class="editor-field"><text>区域</text><picker mode="selector" range="{{editDistricts}}" value="{{editDistrictIndex}}" bindchange="changeEditDistrict"><view class="editor-control"><text>{{editDistricts[editDistrictIndex]}}</text><text>›</text></view></picker></view>
        <view class="editor-field"><text>详细地址</text><input value="{{editForm.address}}" maxlength="120" data-field="address" bindinput="changeEditField" placeholder="道路、门牌号或商场楼层" /></view>
        <view class="editor-field"><text>认证与上架状态</text><picker mode="selector" range="{{verificationOptions}}" range-key="label" value="{{verificationIndex}}" bindchange="changeVerification"><view class="editor-control"><text>{{verificationOptions[verificationIndex].label}}</text><text>›</text></view></picker></view>
        <view class="editor-help">公开可用与认证分开管理。未认证球馆仍可约球；认证操作会记录管理员和时间。</view>
        <button class="editor-more" bindtap="toggleEditMore" disabled="{{saving}}">{{editMore ? '收起选填资料' : '更多资料（选填）'}} {{editMore ? '⌃' : '⌄'}}</button>
        <block wx:if="{{editMore}}">
          <view class="coordinate-row"><view class="editor-field"><text>经度 · 选填</text><input type="digit" value="{{editForm.longitude}}" data-field="longitude" bindinput="changeEditField" placeholder="留空即可" /></view><view class="editor-field"><text>纬度 · 选填</text><input type="digit" value="{{editForm.latitude}}" data-field="latitude" bindinput="changeEditField" placeholder="留空即可" /></view></view>
          <view class="editor-help">仅填写地址也可认证，不需要定位；如填写经纬度，请确认与地址一致。</view>
          <view wx:if="{{verificationOptions[verificationIndex].certified}}" class="editor-field"><text>核验日期 · 选填</text><picker mode="date" value="{{editForm.verificationDate}}" bindchange="changeEditField" data-field="verificationDate"><view class="editor-control"><text>{{editForm.verificationDate || '保存时自动记录今天'}}</text><text>›</text></view></picker></view>
          <view class="editor-field"><text>资料来源 · 选填</text><input value="{{editForm.sourceUrl}}" data-field="sourceUrl" bindinput="changeEditField" placeholder="可留空，或填写 https:// 链接" /></view>
        </block>
        <view wx:if="{{saveError}}" class="editor-error">{{saveError}}</view>
        <button class="primary-button editor-save" bindtap="saveVenue" loading="{{saving}}" disabled="{{saving}}">{{verificationOptions[verificationIndex].certified ? '保存并确认认证' : '保存球馆资料'}}</button>
        <view class="editor-bottom"></view>
      </scroll-view>
    </view>
  </view>
</view>
