.ui-screen { min-height: 100vh; background: #f6f7f5; }
.catalog-page { box-sizing: border-box; padding: 34rpx 28rpx 64rpx; }
.catalog-heading { padding: 10rpx 4rpx 24rpx; }
.catalog-eyebrow { color: var(--brand); font-size: 20rpx; font-weight: 650; letter-spacing: 2rpx; }
.catalog-title { margin-top: 8rpx; color: var(--text); font-size: 42rpx; font-weight: 720; letter-spacing: -1rpx; }
.catalog-subtitle { max-width: 610rpx; margin-top: 12rpx; color: var(--text-secondary); font-size: 22rpx; line-height: 1.6; }
.catalog-tabs { display: grid; grid-template-columns: 1fr 1fr; gap: 6rpx; margin-bottom: 18rpx; padding: 6rpx; border-radius: 17rpx; background: #e9ece8; }
.catalog-tab { min-height: 68rpx; margin: 0; padding: 0; border-radius: 13rpx; background: transparent; color: var(--text-secondary); font-size: 23rpx; font-weight: 600; line-height: 68rpx; }
.catalog-tab::after, .delete-action::after, .edit-action::after, .state-action::after, .load-more::after, .catalog-notice button::after { display: none; }
.catalog-tab.selected { background: #fff; color: var(--text); box-shadow: 0 3rpx 14rpx rgba(25, 45, 36, .07); }
.district-filter { margin-bottom: 16rpx; }
.district-filter-control { display: flex; min-height: 70rpx; padding: 0 18rpx; align-items: center; justify-content: space-between; border: 1rpx solid var(--line); border-radius: 14rpx; background: #fff; color: var(--text); font-size: 22rpx; }
.catalog-list { overflow: hidden; border: 1rpx solid rgba(20, 40, 31, .06); border-radius: 20rpx; background: #fff; }
.catalog-row { display: flex; min-height: 112rpx; box-sizing: border-box; align-items: center; gap: 16rpx; margin: 0 20rpx; padding: 18rpx 0; border-bottom: 1rpx solid var(--line); }
.catalog-row:last-child { border-bottom: 0; }
.catalog-copy { min-width: 0; flex: 1; }
.catalog-name-row { display: flex; min-width: 0; flex-wrap: wrap; align-items: center; gap: 8rpx 10rpx; }
.catalog-name { min-width: 0; overflow: hidden; color: var(--text); font-size: 24rpx; font-weight: 650; text-overflow: ellipsis; white-space: nowrap; }
.catalog-status { flex: none; padding: 4rpx 9rpx; border-radius: 999rpx; background: #f0f1ef; color: var(--text-tertiary); font-size: 17rpx; }
.catalog-status.active { background: var(--brand-faint); color: var(--brand); }
.catalog-meta { display: block; margin-top: 8rpx; overflow: hidden; color: var(--text-secondary); font-size: 20rpx; text-overflow: ellipsis; white-space: nowrap; }
.delete-action { flex: none; width: auto; min-height: 54rpx; margin: 0; padding: 0 12rpx; background: transparent; color: #a7473b; font-size: 20rpx; line-height: 54rpx; }
.edit-action { flex: none; width: auto; min-height: 54rpx; margin: 0; padding: 0 8rpx; background: transparent; color: var(--brand); font-size: 20rpx; line-height: 54rpx; }
.catalog-state { padding: 86rpx 32rpx; border-radius: 20rpx; background: #fff; text-align: center; }
.compact-state { padding: 76rpx 32rpx; }
.state-title { color: var(--text); font-size: 27rpx; font-weight: 650; }
.state-copy { margin-top: 10rpx; color: var(--text-secondary); font-size: 21rpx; line-height: 1.55; }
.state-action { width: auto; min-height: 60rpx; margin: 24rpx auto 0; padding: 0 24rpx; border-radius: 13rpx; background: var(--brand); color: #fff; font-size: 21rpx; line-height: 60rpx; }
.catalog-notice { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; margin-bottom: 14rpx; padding: 16rpx 18rpx; border-radius: 13rpx; background: #fff8eb; color: #745d2f; font-size: 20rpx; line-height: 1.5; }
.catalog-notice.danger { display: block; background: #fff2ef; color: #91463d; }
.catalog-notice button { width: auto; min-height: 48rpx; margin: 0; padding: 0; background: transparent; color: var(--brand); font-size: 20rpx; line-height: 48rpx; }
.load-more { min-height: 66rpx; margin: 18rpx 0 0; border-radius: 14rpx; background: #fff; color: var(--brand); font-size: 21rpx; line-height: 66rpx; }
.skeleton-row { border-bottom-color: transparent; }
.skeleton-avatar { width: 70rpx; height: 70rpx; flex: 0 0 70rpx; border-radius: 18rpx; }
.skeleton-copy { flex: 1; }
.skeleton-title { width: 52%; height: 23rpx; border-radius: 7rpx; }
.skeleton-line { width: 72%; height: 18rpx; margin-top: 13rpx; border-radius: 7rpx; }
.venue-editor { height: 88vh; padding: 18rpx 26rpx 0; }
.editor-head { display: flex; align-items: flex-start; justify-content: space-between; gap: 18rpx; }
.editor-close { display: flex; width: 60rpx; height: 60rpx; flex: 0 0 60rpx; align-items: center; justify-content: center; border-radius: 50%; background: #eef0ed; color: var(--text-secondary); font-size: 33rpx; }
.editor-scroll { height: calc(88vh - 116rpx); margin-top: 12rpx; }
.editor-field { min-width: 0; margin-top: 20rpx; }
.editor-field > text { display: block; margin-bottom: 9rpx; color: var(--text); font-size: 22rpx; font-weight: 620; }
.editor-field input, .editor-control { display: flex; width: 100%; min-height: 76rpx; padding: 0 17rpx; align-items: center; justify-content: space-between; border: 1rpx solid #dce2dd; border-radius: 13rpx; background: #fff; color: var(--text); font-size: 23rpx; }
.coordinate-row { display: grid; grid-template-columns: 1fr 1fr; gap: 12rpx; }
.editor-help { margin-top: 9rpx; color: var(--text-tertiary); font-size: 19rpx; line-height: 1.5; }
.editor-error { margin-top: 20rpx; padding: 13rpx 15rpx; border-radius: 10rpx; background: #fff0ec; color: #98493f; font-size: 20rpx; }
.editor-save { margin-top: 24rpx; min-height: 84rpx; }
.editor-bottom { height: calc(28rpx + env(safe-area-inset-bottom)); }
.editor-more { display: flex; align-items: center; justify-content: center; width: 100%; min-height: 68rpx; margin: 18rpx 0 0; color: var(--text-secondary); background: #f6f8f5; border-radius: 12rpx; font-size: 22rpx; line-height: 1.4; }
