.ui-screen .venue-page { min-height: 100vh; }
.ui-screen .venue-loading { padding-top: 30rpx; }
.ui-screen .venue-tab-loading { padding-top: 24rpx; }
.ui-screen .venue-row-skeleton { height: 110rpx; margin-bottom: 16rpx; }
.ui-screen .venue-cover-skeleton { height: 360rpx; }
.ui-screen .venue-block-skeleton { height: 230rpx; margin-top: 22rpx; }
.ui-screen .venue-content { padding-top: 28rpx; padding-bottom: calc(180rpx + env(safe-area-inset-bottom)); min-height: auto; }
.ui-screen .venue-title-row { display: flex; align-items: flex-start; gap: 20rpx; }
.ui-screen .venue-title-main { min-width: 0; flex: 1; }
.ui-screen .verified-row { display: flex; gap: 16rpx; color: var(--text-tertiary); font-size: 21rpx; }
.ui-screen .verified-row text:first-child { color: var(--success); }
.ui-screen .venue-title { line-height: 1.3; margin-top: 6rpx; font-size: 40rpx; font-weight: 650; }
.ui-screen .venue-location { display: flex; width: 100%; min-height: 72rpx; margin: 8rpx 0 0; padding: 0; align-items: center; justify-content: space-between; gap: 16rpx; color: var(--text-secondary); font-size: 24rpx; line-height: 1.5; text-align: left; background: transparent; }
.ui-screen .venue-location-copy { display: flex; min-width: 0; flex: 1; align-items: flex-start; gap: 10rpx; }
.ui-screen .venue-location-copy > text:last-child { min-width: 0; flex: 1; }
.ui-screen .venue-location-label { flex: none; color: var(--text-tertiary); font-size: 21rpx; }
.ui-screen .venue-location-action { flex: none; color: var(--brand); font-size: 22rpx; white-space: nowrap; }
.ui-screen .venue-location-action text { margin-left: 2rpx; font-size: 19rpx; }
.ui-screen .venue-location-press { opacity: .58; }
.ui-screen .venue-activity-tags { display: flex; flex-wrap: wrap; gap: 10rpx; margin-top: 18rpx; }
.ui-screen .venue-activity-tags text { min-height: 44rpx; padding: 0 16rpx; background: var(--brand-soft); color: var(--brand); line-height: 44rpx; font-size: 23rpx; border-radius: 8rpx; }
.ui-screen .favorite-button { flex: 0 0 144rpx; border: 2rpx solid var(--line); border-radius: 14rpx; background: #fff; color: var(--text-secondary); display: flex; width: 126rpx; flex-basis: 126rpx; margin: 0; min-height: 72rpx; align-items: center; justify-content: center; font-size: 23rpx; line-height: 1.4; border-width: 1rpx; }
.ui-screen .favorite-button.active { border-color: var(--brand-soft); background: var(--brand-soft); color: var(--brand); }
.ui-screen .favorite-button.unknown { border-style: dashed; color: var(--text-tertiary); }
.ui-screen .favorite-button[disabled] { opacity: .58; }
.ui-screen .venue-actions { display: grid; grid-template-columns: 1fr 1fr; gap: 14rpx; margin-top: 28rpx; }
.ui-screen .venue-actions.single { grid-template-columns: 1fr; }
.ui-screen .venue-actions button { min-height: 82rpx; border: 2rpx solid var(--line); border-radius: 14rpx; background: #fff; font-weight: 600; display: flex; width: 100%; margin: 0; align-items: center; justify-content: center; font-size: 25rpx; line-height: 1.4; border-width: 1rpx; }
.ui-screen .venue-actions button[disabled] { color: #a0a4aa; }
.ui-screen .venue-information { background: #fff; padding: 0; border-radius: 0; margin-top: 26rpx; }
.ui-screen .venue-information view { display: flex; justify-content: space-between; gap: 30rpx; padding: 22rpx 0; border-bottom: 2rpx solid var(--line); font-size: 25rpx; border-bottom-width: 1rpx; }
.ui-screen .venue-information view:last-child { border-bottom: 0; }
.ui-screen .venue-information text:first-child { flex: 0 0 136rpx; color: var(--text-secondary); }
.ui-screen .venue-information text:last-child { text-align: right; line-height: 1.5; }
.ui-screen .venue-notice { margin-top: 18rpx; padding: 20rpx 22rpx; border-radius: 14rpx; line-height: 1.6; border: 0; background: var(--surface-muted); color: var(--text-secondary); font-size: 23rpx; }
.ui-screen .content-tabs { display: grid; grid-template-columns: 1fr 1fr; margin-top: 38rpx; border-bottom: 2rpx solid var(--line); }
.ui-screen .content-tab { position: relative; color: var(--text-secondary); font-weight: 600; display: flex; width: 100%; margin: 0; align-items: center; justify-content: center; min-height: 92rpx; font-size: 27rpx; line-height: 1.4; }
.ui-screen .content-tab text { margin-left: 6rpx; color: var(--text-tertiary); font-size: 22rpx; }
.ui-screen .content-tab.active { color: var(--text); }
.ui-screen .content-tab.active::after { content: ''; position: absolute; top: auto; right: 28%; bottom: 0; left: 28%; width: auto; height: 4rpx; transform: none; border: 0; border-radius: 999rpx; background: var(--brand); }
.ui-screen .venue-match-list, .ui-screen .venue-coach-list { background: #fff; }
.ui-screen .venue-match { display: flex; width: 100%; align-items: center; gap: 20rpx; min-height: 132rpx; border-bottom: 2rpx solid var(--line); text-align: left; }
.ui-screen .venue-match-time { display: flex; flex: 0 0 110rpx; flex-direction: column; color: var(--text-secondary); font-size: 21rpx; }
.ui-screen .venue-match-time text:last-child { margin-top: 6rpx; color: var(--text); font-size: 30rpx; font-weight: 650; }
.ui-screen .venue-match-main { display: flex; min-width: 0; flex: 1; flex-direction: column; }
.ui-screen .venue-match-main text:first-child { overflow: hidden; font-size: 27rpx; font-weight: 620; text-overflow: ellipsis; white-space: nowrap; }
.ui-screen .venue-match-main text:last-child { margin-top: 8rpx; color: var(--text-secondary); font-size: 22rpx; }
.ui-screen .venue-match-fee { flex: none; font-size: 25rpx; font-weight: 620; }
.ui-screen .venue-empty { padding-top: 64rpx; padding-bottom: 54rpx; padding: 56rpx 22rpx; }
.ui-screen .venue-publish { margin-top: 0; }
.ui-screen .venue-coach { display: flex; width: 100%; align-items: center; gap: 18rpx; min-height: 142rpx; border-bottom: 2rpx solid var(--line); text-align: left; }
.ui-screen .venue-coach image, .ui-screen .coach-placeholder { display: flex; width: 82rpx; height: 82rpx; flex: 0 0 82rpx; align-items: center; justify-content: center; border-radius: 14rpx; background: #eceef1; color: var(--text-secondary); font-size: 20rpx; }
.ui-screen .coach-copy { display: flex; min-width: 0; flex: 1; flex-direction: column; }
.ui-screen .coach-copy text:first-child { font-size: 27rpx; font-weight: 620; }
.ui-screen .coach-copy text:nth-child(2) { overflow: hidden; margin-top: 6rpx; color: var(--text-secondary); font-size: 22rpx; text-overflow: ellipsis; white-space: nowrap; }
.ui-screen .coach-copy text:last-child { margin-top: 6rpx; color: var(--success); font-size: 21rpx; }
.ui-screen .coach-fee { flex: none; font-size: 25rpx; font-weight: 620; }

.ui-screen .venue-match, .ui-screen .venue-coach { margin: 0; min-height: 140rpx; line-height: 1.5; border-bottom-width: 1rpx; }
.ui-screen .venue-publish-dock { position: fixed; z-index: 30; bottom: 0; left: 0; right: 0; padding: 18rpx 32rpx calc(18rpx + env(safe-area-inset-bottom)); background: #fff; border-top: 1rpx solid var(--line); }

.ui-screen .venue-photos { margin-top: 32rpx; padding-top: 30rpx; border-top: 1rpx solid var(--line); }
.ui-screen .photos-heading { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; }
.ui-screen .photos-title { font-size: 30rpx; font-weight: 650; line-height: 1.4; }
.ui-screen .photos-title text { margin-left: 8rpx; font-size: 23rpx; color: var(--text-tertiary); font-weight: 400; }
.ui-screen .photos-caption { margin-top: 7rpx; font-size: 22rpx; line-height: 1.6; color: var(--text-secondary); }
.ui-screen .photos-empty { display: flex; align-items: center; justify-content: center; gap: 18rpx; min-height: 144rpx; margin-top: 20rpx; background: var(--surface-muted); border-radius: 16rpx; color: var(--text-tertiary); font-size: 23rpx; }
.ui-screen .photos-camera { position: relative; flex: none; width: 38rpx; height: 28rpx; border: 2rpx solid #8b9992; border-radius: 6rpx; }
.ui-screen .photos-camera::before { content: ''; position: absolute; top: -8rpx; left: 10rpx; width: 14rpx; height: 6rpx; border: 2rpx solid #8b9992; border-bottom: 0; border-radius: 3rpx 3rpx 0 0; }
.ui-screen .photos-camera view { position: absolute; top: 6rpx; left: 12rpx; width: 10rpx; height: 10rpx; border: 2rpx solid #8b9992; border-radius: 50%; }
.ui-screen .photos-strip { width: 100%; margin-top: 22rpx; white-space: nowrap; }
.ui-screen .photos-thumb { display: inline-flex; width: 214rpx; height: 158rpx; margin: 0 12rpx 0 0; padding: 0; border-radius: 14rpx; overflow: hidden; background: var(--surface-muted); }
.ui-screen .photos-thumb image { display: block; width: 100%; height: 100%; }
.ui-screen .photos-sync { margin-top: 16rpx; font-size: 21rpx; color: var(--text-tertiary); }
.ui-screen .photos-retry { display: flex; justify-content: space-between; align-items: center; gap: 12rpx; margin-top: 14rpx; color: var(--text-secondary); font-size: 22rpx; }
.ui-screen .photos-retry button { display: flex; align-items: center; justify-content: center; width: auto; min-width: 80rpx; min-height: 64rpx; margin: 0; font-size: 23rpx; color: var(--brand); }
.ui-screen .photos-mine-toggle { display: flex; align-items: center; justify-content: space-between; width: 100%; min-height: 84rpx; margin: 12rpx 0 0; font-size: 24rpx; line-height: 1.4; text-align: left; }
.ui-screen .photos-mine-toggle > text:last-child { color: var(--brand); font-size: 22rpx; }
.ui-screen .photos-mine-count { margin-left: 10rpx; color: var(--text-tertiary); }
.ui-screen .photo-mine-row { display: flex; align-items: center; gap: 16rpx; padding: 18rpx 0; border-top: 1rpx solid var(--line); }
.ui-screen .photo-mine-row > image, .ui-screen .photo-mine-placeholder { width: 84rpx; height: 84rpx; flex: none; border-radius: 10rpx; background: var(--surface-muted); }
.ui-screen .photo-mine-placeholder { display: flex; align-items: center; justify-content: center; }
.ui-screen .photo-mine-copy { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 6rpx; font-size: 21rpx; line-height: 1.5; color: var(--text-secondary); }
.ui-screen .photo-mine-status { font-size: 24rpx; color: var(--text); }
.ui-screen .photo-mine-status.passed { color: var(--brand); }
.ui-screen .photo-mine-status.rejected { color: #a64435; }
.ui-screen .photo-mine-delete { flex: none; width: auto; min-width: 88rpx; min-height: 72rpx; margin: 0; display: flex; align-items: center; justify-content: center; font-size: 23rpx; line-height: 1.4; color: var(--text-secondary); }
