<view class="ui-screen">
  <view class="admin-review-page" aria-hidden="{{detailVisible}}">
    <view class="review-heading">
      <view>
        <view class="review-eyebrow">运营工作台</view>
        <view class="review-title">教练认证审核</view>
        <view class="review-subtitle">核验教学经历与联系方式，通过后再配置可约时段。</view>
      </view>
      <view wx:if="{{state === 'ready'}}" class="queue-count"><text>{{items.length}}{{hasMore ? '+' : ''}}</text><text>待处理</text></view>
    </view>

    <view wx:if="{{state === 'loading'}}" class="review-loading" aria-live="polite">
      <view wx:for="{{skeletonRows}}" wx:key="*this" class="review-skeleton-row">
        <view class="skeleton review-skeleton-avatar"></view>
        <view class="review-skeleton-copy">
          <view class="skeleton review-skeleton-title"></view>
          <view class="skeleton review-skeleton-line"></view>
        </view>
      </view>
    </view>

    <view wx:elif="{{state === 'forbidden'}}" class="review-status">
      <view class="status-mark">锁</view>
      <view class="status-title">没有审核权限</view>
      <view class="status-copy">管理员名单由云端配置；页面入口只是提示，所有审核操作仍会由云函数再次验证。</view>
      <button class="status-action" bindtap="retryLoad" hover-class="review-press">重新校验</button>
    </view>

    <view wx:elif="{{state === 'error'}}" class="review-status">
      <view class="status-mark muted-mark">·</view>
      <view class="status-title">{{loginRequired ? '请先登录' : '待审列表暂时没加载出来'}}</view>
      <view class="status-copy">{{errorMessage}}</view>
      <button class="status-action" bindtap="retryLoad" hover-class="review-press">{{loginRequired ? '微信登录' : '重新加载'}}</button>
    </view>

    <block wx:elif="{{state === 'ready'}}">
      <view wx:if="{{syncError}}" class="sync-notice" aria-live="polite">
        <text>刷新失败，当前显示上次结果</text>
        <button bindtap="retryLoad" hover-class="review-press">重试</button>
      </view>

      <view wx:if="{{items.length}}" class="review-list">
        <view
          wx:for="{{items}}"
          wx:key="id"
          class="review-row"
          role="button"
          aria-label="{{item.ariaLabel}}"
          data-id="{{item.id}}"
          bindtap="openApplication"
          hover-class="review-row-press"
          hover-stay-time="80"
        >
          <player-avatar seed="{{item.id || item.name}}" size="72" label="{{item.name}}的头像" />
          <view class="review-row-copy">
            <view class="review-row-title">{{item.name}}</view>
            <view class="review-row-meta">{{item.venueName}} · {{item.experienceText}}经验</view>
            <view wx:if="{{item.specialty.length}}" class="review-row-tags">
              <text wx:for="{{item.specialty}}" wx:for-item="tag" wx:key="*this">{{tag}}</text>
            </view>
            <view class="coach-submit-time">{{item.submittedText}}</view>
          </view>
          <text class="review-chevron" aria-hidden="true">›</text>
        </view>
        <button wx:if="{{hasMore}}" class="load-more" bindtap="loadMore" loading="{{loadingMore}}" disabled="{{loadingMore}}" hover-class="review-press">{{loadingMore ? '加载中' : '继续加载'}}</button>
      </view>

      <view wx:else class="review-status empty-status">
        <view class="empty-check">✓</view>
        <view class="status-title">待审申请已清空</view>
        <view class="status-copy">新的教练认证申请会显示在这里。</view>
      </view>
    </block>
  </view>

  <view wx:if="{{detailVisible}}" class="review-sheet-mask" catchtap="closeDetail">
    <view class="review-sheet coach-review-sheet" aria-role="dialog" aria-label="审核教练：{{selectedApplication.name}}" catchtap="noop">
      <view class="sheet-handle"></view>
      <view class="sheet-head">
        <view>
          <view class="sheet-kicker">待审教练</view>
          <view class="sheet-name">{{selectedApplication.name}}</view>
          <view class="sheet-caption">{{selectedApplication.submittedText}}提交</view>
        </view>
        <button class="sheet-close" aria-label="关闭" bindtap="closeDetail" disabled="{{reviewing || statusChecking}}" hover-class="review-press">×</button>
      </view>

      <view class="detail-facts coach-detail-facts">
        <view class="detail-fact">
          <text>联系电话</text>
          <text user-select="true">{{selectedApplication.mobile || '未填写'}}</text>
        </view>
        <view class="detail-fact">
          <text>教学或训练经验</text>
          <text>{{selectedApplication.experienceText}}</text>
        </view>
        <view class="detail-fact">
          <text>申请填写球馆</text>
          <text>{{selectedApplication.venueName}}</text>
        </view>
      </view>

      <view class="detail-section">
        <view class="detail-label">擅长方向</view>
        <view wx:if="{{selectedApplication.specialty.length}}" class="detail-tags">
          <text wx:for="{{selectedApplication.specialty}}" wx:key="*this">{{item}}</text>
        </view>
        <view wx:else class="detail-empty">用户未填写</view>
      </view>

      <view class="detail-section coach-copy-section">
        <view class="detail-label">资历说明</view>
        <view class="detail-paragraph">{{selectedApplication.qualification || '用户未填写'}}</view>
      </view>

      <view wx:if="{{selectedApplication.introduction}}" class="detail-section coach-copy-section">
        <view class="detail-label">教学简介</view>
        <view class="detail-paragraph">{{selectedApplication.introduction}}</view>
      </view>

      <view class="privacy-note">姓名和教学资料通过后会公开；手机号仅运营可见，审核留痕由系统自动记录。</view>

      <view wx:if="{{reviewMode !== 'reject' && !outcomeUnknown && !conflictPending}}" class="approval-panel">
        <view class="approval-heading">
          <view>
            <view class="approval-title">通过前补齐核验记录</view>
            <view class="approval-copy">可关联球馆目录中已上架的地点，最多 10 家；名称记录只表示授课地点，不代表合作认证。</view>
          </view>
          <text>{{selectedVenueIds.length}} 家</text>
        </view>

        <view class="approval-field">
          <view class="approval-label">关联授课球馆</view>
          <view wx:if="{{venuesState === 'loading'}}" class="venue-state">正在加载球馆目录…</view>
          <view wx:elif="{{venuesState === 'error'}}" class="venue-state venue-state-error">
            <text>{{venuesError}}</text>
            <button bindtap="retryVenues" hover-class="review-press">重试</button>
          </view>
          <view wx:elif="{{!venues.length}}" class="venue-state venue-state-empty">暂无可关联球馆，可先录入一个球馆名称。</view>
          <view wx:else class="venue-options">
            <button
              wx:for="{{venues}}"
              wx:key="id"
              class="venue-option {{item.selected ? 'selected' : ''}}"
              data-id="{{item.id}}"
              bindtap="toggleVenue"
              disabled="{{reviewing}}"
              hover-class="review-press"
            >
              <text class="venue-option-name">{{item.name}}</text>
              <text class="venue-option-meta">{{item.meta}}</text>
            </button>
          </view>
          <button class="venue-create-link" bindtap="createVenue" disabled="{{reviewing}}" hover-class="review-press">没找到？录入球馆</button>
        </view>

        <view class="approval-grid">
          <view class="approval-field compact-field">
            <view class="approval-label">身份核验日期</view>
            <picker mode="date" value="{{verificationDate}}" end="{{maxVerificationDate}}" disabled="{{reviewing}}" bindchange="changeVerificationDate">
              <view class="approval-input approval-picker"><text>{{verificationDate || '请选择'}}</text><text aria-hidden="true">›</text></view>
            </picker>
          </view>
          <view class="approval-field compact-field rank-field">
            <view class="approval-label">推荐排序 <text>选填</text></view>
            <input class="approval-input" type="number" maxlength="4" value="{{featuredRank}}" placeholder="默认排序" placeholder-class="approval-placeholder" disabled="{{reviewing}}" bindinput="changeFeaturedRank" />
          </view>
        </view>

        <view wx:if="{{approvalError}}" class="approval-error" aria-role="alert">{{approvalError}}</view>
      </view>

      <view class="review-principle">
        <view class="principle-dot"></view>
        <view>请人工核对身份、联系方式和资历。无法核实或资料不完整时，请驳回并写明可操作的修改建议。</view>
      </view>

      <view wx:if="{{detailError}}" class="detail-message {{outcomeUnknown || conflictPending ? 'is-warning' : ''}}" aria-role="alert">{{detailError}}</view>

      <view wx:if="{{reviewMode === 'reject' && !outcomeUnknown && !conflictPending}}" class="reject-panel">
        <label for="coach-reject-reason" class="reject-label">驳回原因</label>
        <textarea id="coach-reject-reason" class="reject-input" value="{{rejectionReason}}" maxlength="{{maxReasonLength}}" auto-height placeholder="例如：资历说明暂时无法核实，请补充可核验的执教经历" placeholder-class="reject-placeholder" disabled="{{reviewing}}" bindinput="changeRejectionReason" />
        <view class="reject-meta">
          <text class="reason-error">{{reasonError}}</text>
          <text>{{rejectionReason.length}}/{{maxReasonLength}}</text>
        </view>
        <view class="reject-actions">
          <button class="secondary-action" bindtap="cancelReject" disabled="{{reviewing}}" hover-class="review-press">取消</button>
          <button class="danger-action" bindtap="rejectApplication" loading="{{reviewing}}" disabled="{{reviewing}}" hover-class="review-press">确认驳回</button>
        </view>
      </view>

      <view wx:elif="{{outcomeUnknown}}" class="unknown-actions">
        <button class="secondary-action wide-action" bindtap="syncSelectedStatus" loading="{{statusChecking}}" disabled="{{reviewing || statusChecking}}" hover-class="review-press">{{statusChecking ? '正在同步' : '先同步状态'}}</button>
        <button class="primary-action wide-action" bindtap="retryUnknownReview" loading="{{reviewing}}" disabled="{{reviewing || statusChecking}}" hover-class="review-press">{{reviewing ? '正在重试' : '重试原操作'}}</button>
      </view>

      <view wx:elif="{{conflictPending}}" class="unknown-actions single-action">
        <button class="primary-action wide-action" bindtap="syncSelectedStatus" loading="{{statusChecking}}" disabled="{{statusChecking}}" hover-class="review-press">{{statusChecking ? '正在刷新' : '刷新最新状态'}}</button>
      </view>

      <view wx:else class="review-actions">
        <button class="secondary-action" bindtap="beginReject" disabled="{{reviewing}}" hover-class="review-press">驳回</button>
        <button class="primary-action" bindtap="approveApplication" loading="{{reviewing}}" disabled="{{reviewing || venuesState !== 'ready' || !venues.length}}" hover-class="review-press">{{reviewing ? '提交中' : '通过审核'}}</button>
      </view>
    </view>
  </view>
</view>
