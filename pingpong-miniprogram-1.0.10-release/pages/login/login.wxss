.login-page { min-height: 100vh; padding: 64rpx 48rpx calc(40rpx + env(safe-area-inset-bottom)); display: flex; flex-direction: column; justify-content: space-between; background: #fff; }
.login-intro { padding-bottom: 96rpx; }
.login-brand { display: flex; align-items: center; gap: 18rpx; color: var(--brand); font-size: 32rpx; font-weight: 650; }
.login-brand text { padding-left: 18rpx; border-left: 1rpx solid var(--line-strong); font-size: 23rpx; font-weight: 400; color: var(--text-secondary); }
.login-title { margin-top: 90rpx; font-size: 72rpx; line-height: 1.3; font-weight: 650; letter-spacing: -2rpx; }
.login-copy { margin-top: 30rpx; color: var(--text-secondary); font-size: 27rpx; line-height: 1.85; }
.login-detail { display: flex; flex-wrap: wrap; gap: 12rpx 24rpx; margin-bottom: 26rpx; color: var(--text-secondary); font-size: 23rpx; }
.login-detail text + text { padding-left: 24rpx; border-left: 1rpx solid var(--line); }
.login-error { margin-bottom: 22rpx; color: var(--danger); font-size: 25rpx; line-height: 1.6; }
.ui-screen .login-button { min-height: 100rpx; border-radius: 18rpx; font-size: 30rpx; font-weight: 600; }
.login-agreement { display: flex; align-items: center; flex-wrap: wrap; margin-top: 24rpx; color: var(--text-secondary); font-size: 22rpx; line-height: 1.8; }
.login-agreement label { display: flex; align-items: center; min-height: 64rpx; }
.login-agreement checkbox { transform: scale(.75); transform-origin: left center; width: 42rpx; }
.ui-screen .login-agreement button { display: flex; align-items: center; justify-content: center; color: var(--brand); font-size: 22rpx; min-height: 64rpx; }
.ui-screen .login-later { display: flex; align-items: center; justify-content: center; width: 100%; min-height: 88rpx; margin-top: 12rpx; color: var(--text-secondary); font-size: 26rpx; }
