.friends-page { padding-top: 22rpx; padding-bottom: calc(92rpx + env(safe-area-inset-bottom)); background: #fff; }
.friends-hero { padding: 16rpx 0 24rpx; }
.friends-title { color: var(--text); font-size: 44rpx; font-weight: 680; letter-spacing: -1rpx; }
.friends-copy { margin-top: 8rpx; color: var(--text-secondary); font-size: 23rpx; line-height: 1.55; }
.section-switch { display: grid; grid-template-columns: 1fr 1fr; height: 70rpx; padding: 5rpx; border-radius: 16rpx; background: #f1f3f0; }
.section-switch .switch-item { display: flex; width: 100%; height: 60rpx; align-items: center; justify-content: center; border-radius: 12rpx; color: var(--text-secondary); font-size: 24rpx; }
.section-switch .switch-item.is-active { background: #fff; color: var(--text); font-weight: 650; box-shadow: 0 2rpx 10rpx rgba(20, 35, 28, .08); }
.create-update-card { display: flex; width: 100%; min-height: 104rpx; margin-top: 24rpx; padding: 18rpx; align-items: center; gap: 16rpx; border: 1rpx solid #dce5df; border-radius: 18rpx; background: #f7faf8; text-align: left; }
.create-update-press { border-color: #c8d9cf; background: var(--brand-faint); transform: scale(.995); }
.create-update-icon { position: relative; width: 52rpx; height: 52rpx; flex: 0 0 52rpx; border-radius: 50%; background: var(--brand); }
.create-update-icon::before, .create-update-icon::after { position: absolute; top: 25rpx; left: 16rpx; width: 20rpx; height: 2rpx; border-radius: 2rpx; background: #fff; content: ''; }
.create-update-icon::after { transform: rotate(90deg); }
.create-update-copy { display: flex; min-width: 0; flex: 1; flex-direction: column; gap: 3rpx; color: var(--text-secondary); font-size: 21rpx; line-height: 1.45; }
.create-update-title { color: var(--text); font-size: 26rpx; font-weight: 650; }
.create-update-action { display: flex; min-width: 76rpx; min-height: 52rpx; flex: none; align-items: center; justify-content: center; padding: 0 16rpx; border-radius: 999rpx; background: var(--brand); color: #fff; font-size: 21rpx; font-weight: 600; }
.my-update-card { position: relative; display: flex; min-height: 148rpx; margin-top: 24rpx; padding: 24rpx 22rpx; align-items: center; gap: 18rpx; border: 1rpx solid #dfe6e1; border-radius: 20rpx; background: #f7f9f7; }
.my-update-card.has-update { padding-bottom: 60rpx; border-color: #cfe1d7; background: #f0f7f3; }
.my-update-main { min-width: 0; flex: 1; }
.my-update-kicker { color: var(--brand); font-size: 21rpx; font-weight: 650; }
.my-update-time { margin-top: 8rpx; color: var(--text); font-size: 27rpx; font-weight: 650; }
.my-update-copy { margin-top: 7rpx; color: var(--text-secondary); font-size: 22rpx; line-height: 1.5; }
.my-update-action { display: flex; flex: 0 0 auto; min-width: 100rpx; height: 64rpx; padding: 0 20rpx; align-items: center; justify-content: center; border-radius: 12rpx; background: var(--brand); color: #fff; font-size: 23rpx; font-weight: 600; }
.withdraw-action { position: absolute; right: 22rpx; bottom: 13rpx; color: #8a5d55; font-size: 20rpx; }
.soft-press { opacity: .68; }
.feed-heading { display: flex; margin-top: 32rpx; align-items: flex-end; justify-content: space-between; }
.feed-title { color: var(--text); font-size: 30rpx; font-weight: 650; }
.feed-caption { margin-top: 4rpx; color: var(--text-tertiary); font-size: 20rpx; }
.friends-loading { padding-top: 20rpx; }
.update-skeleton { height: 230rpx; margin-top: 16rpx; border-radius: 20rpx; }
.update-list { margin-top: 8rpx; }
.update-card { padding: 26rpx 0 24rpx; border-bottom: 1rpx solid var(--line); background: #fff; }
.update-card:last-child { border-bottom: 0; }
.update-head { display: flex; align-items: flex-start; gap: 14rpx; }
.update-author { display: flex; width: 100%; align-items: center; gap: 16rpx; text-align: left; }
.update-author-copy { min-width: 0; flex: 1; }
.update-name-row { display: flex; min-width: 0; align-items: center; gap: 10rpx; }
.update-name { overflow: hidden; color: var(--text); font-size: 27rpx; font-weight: 650; text-overflow: ellipsis; white-space: nowrap; }
.score-chip { flex: none; padding: 3rpx 9rpx; border-radius: 7rpx; background: #eef2e6; color: #536236; font-size: 18rpx; }
.update-location { display: block; margin-top: 4rpx; color: var(--text-secondary); font-size: 21rpx; }
.update-kind { flex: none; margin-top: 5rpx; padding: 5rpx 10rpx; border-radius: 999rpx; background: #eef4f0; color: var(--brand); font-size: 18rpx; }
.update-kind.tip { background: #f2f0e9; color: #6f5c35; }
.update-detail-link { display: block; width: 100%; padding: 0; border: 0; border-radius: 0; background: transparent; color: inherit; line-height: inherit; text-align: left; }
.update-detail-link::after { display: none; }
.update-schedule { display: flex; min-height: 76rpx; margin-top: 18rpx; padding: 15rpx 17rpx; align-items: center; gap: 13rpx; border-radius: 14rpx; background: var(--brand-faint); color: var(--text); font-size: 24rpx; font-weight: 650; }
.time-mark { position: relative; width: 28rpx; height: 28rpx; flex: none; border: 2rpx solid var(--brand); border-radius: 50%; }
.time-mark::before, .time-mark::after { position: absolute; left: 12rpx; top: 6rpx; width: 2rpx; height: 8rpx; border-radius: 2rpx; background: var(--brand); content: ''; transform-origin: bottom; }
.time-mark::after { transform: rotate(120deg); }
.update-time-copy { min-width: 0; flex: 1; }
.update-main-time { display: block; font-size: 25rpx; font-weight: 650; }
.update-note { display: block; margin-top: 4rpx; color: var(--text-secondary); font-size: 21rpx; font-weight: 400; }
.update-venue { display: flex; margin-top: 14rpx; align-items: center; gap: 9rpx; color: var(--text-secondary); font-size: 22rpx; }
.venue-pin { width: 16rpx; height: 16rpx; flex: none; border: 2rpx solid var(--brand); border-radius: 50% 50% 50% 0; transform: rotate(-45deg); }
.update-venue text { min-width: 0; overflow: hidden; flex: 1; text-overflow: ellipsis; white-space: nowrap; }
.update-content { display: -webkit-box; max-height: 206rpx; overflow: hidden; margin-top: 16rpx; color: var(--text); font-size: 25rpx; line-height: 1.65; white-space: pre-wrap; overflow-wrap: anywhere; -webkit-box-orient: vertical; -webkit-line-clamp: 5; }
.update-actions { display: flex; min-height: 62rpx; margin-top: 14rpx; align-items: center; gap: 8rpx; }
.update-match-action { display: flex; width: auto; min-height: 56rpx; padding: 0 16rpx; align-items: center; justify-content: center; border-radius: 999rpx; background: var(--brand-soft); color: var(--brand); font-size: 20rpx; font-weight: 600; }
.update-reply-action { display: flex; width: auto; min-height: 56rpx; padding: 0 12rpx; align-items: center; gap: 9rpx; color: var(--text-secondary); font-size: 20rpx; }
.reply-icon { position: relative; width: 23rpx; height: 18rpx; border: 2rpx solid currentColor; border-radius: 7rpx; }
.reply-icon::after { position: absolute; bottom: -5rpx; left: 4rpx; width: 6rpx; height: 6rpx; border-bottom: 2rpx solid currentColor; border-left: 2rpx solid currentColor; background: #fff; content: ''; transform: skewY(-32deg); }
.update-remove { width: auto; min-height: 60rpx; margin-left: auto; padding: 0 7rpx; color: #976158; font-size: 20rpx; }
.match-action-press { background: #dcebe3; }
.friends-status, .friends-empty, .updates-empty { margin-top: 24rpx; }
.updates-empty { padding: 66rpx 28rpx 50rpx; }
.empty-clock { position: relative; width: 60rpx; height: 60rpx; margin: 0 auto 22rpx; border: 2rpx solid var(--brand); border-radius: 50%; }
.empty-clock::before, .empty-clock::after { position: absolute; left: 28rpx; top: 14rpx; width: 2rpx; height: 17rpx; background: var(--brand); content: ''; transform-origin: bottom; }
.empty-clock::after { transform: rotate(120deg); }
.friends-section-copy { margin-top: 24rpx; padding: 18rpx 20rpx; border-radius: 14rpx; background: var(--surface-muted); color: var(--text-secondary); font-size: 21rpx; line-height: 1.55; }
.friend-skeleton { height: 124rpx; margin-top: 14rpx; border-radius: 16rpx; }
.friend-list { margin-top: 8rpx; }
.friend-row { display: flex; width: 100%; min-height: 128rpx; margin: 0; padding: 20rpx 0; align-items: center; gap: 18rpx; border-bottom: 1rpx solid var(--line); background: #fff; text-align: left; }
.friend-row-press { background: var(--brand-faint); }
.friend-body { min-width: 0; flex: 1; }
.friend-name-row { display: flex; min-width: 0; align-items: baseline; gap: 12rpx; }
.friend-name { min-width: 0; overflow: hidden; color: var(--text); font-size: 28rpx; font-weight: 650; text-overflow: ellipsis; white-space: nowrap; }
.friend-relation { flex: none; color: var(--brand); font-size: 20rpx; }
.friend-meta { display: block; overflow: hidden; margin-top: 7rpx; color: var(--text-secondary); font-size: 22rpx; text-overflow: ellipsis; white-space: nowrap; }
.friend-skills { display: flex; flex-wrap: wrap; gap: 10rpx; margin-top: 9rpx; }
.friend-skill { padding: 4rpx 10rpx; border-radius: 7rpx; background: var(--surface-muted); color: var(--text-secondary); font-size: 20rpx; }
.friend-chevron { flex: none; color: var(--text-tertiary); font-size: 34rpx; font-weight: 300; }
.friends-notice { display: flex; min-height: 68rpx; margin-top: 18rpx; align-items: center; justify-content: space-between; gap: 14rpx; color: var(--text-secondary); font-size: 22rpx; }
.friends-notice text { min-width: 0; flex: 1; }
.friends-notice button { flex: none; width: auto; min-height: 60rpx; margin: 0; padding: 0 10rpx; color: var(--brand); font-size: 22rpx; }
.friends-empty { padding: 56rpx 28rpx; background: var(--surface-muted); }
.empty-mark { position: relative; width: 72rpx; height: 46rpx; margin: 0 auto 22rpx; }
.empty-mark view { position: absolute; top: 0; width: 40rpx; height: 40rpx; border: 2rpx solid var(--brand); border-radius: 50%; background: #fff; }
.empty-mark view:first-child { left: 4rpx; }
.empty-mark view:last-child { right: 4rpx; }
.friends-more { display: flex; justify-content: center; margin-top: 24rpx; }
.friends-more button { width: auto; min-height: 72rpx; margin: 0; padding: 0 26rpx; border: 1rpx solid var(--line); border-radius: 14rpx; color: var(--text-secondary); font-size: 23rpx; }
.update-composer { display: flex; height: 91vh; max-height: 91vh; padding: 16rpx 28rpx 0; flex-direction: column; overflow: hidden; }
.update-composer .sheet-handle { flex: none; margin-bottom: 22rpx; }
.composer-head { display: flex; align-items: flex-start; justify-content: space-between; gap: 22rpx; }
.composer-head .sheet-copy { margin-top: 6rpx; font-size: 22rpx; }
.composer-close { display: flex; flex: 0 0 62rpx; width: 62rpx; height: 62rpx; align-items: center; justify-content: center; border-radius: 50%; background: #eef0ec; color: var(--text-secondary); font-size: 34rpx; }
.kind-switch { display: grid; flex: none; grid-template-columns: 1fr 1fr; gap: 10rpx; margin-top: 20rpx; }
.kind-item { display: flex; min-height: 78rpx; padding: 10rpx 14rpx; flex-direction: column; align-items: flex-start; justify-content: center; border: 1rpx solid var(--line); border-radius: 14rpx; background: #fff; color: var(--text-secondary); text-align: left; }
.kind-item.active { border-color: #b9d2c4; background: var(--brand-faint); color: var(--brand); }
.kind-title { font-size: 23rpx; font-weight: 650; }
.kind-copy { margin-top: 2rpx; color: var(--text-tertiary); font-size: 18rpx; font-weight: 400; }
.kind-item.active .kind-copy { color: #517565; }
.composer-scroll { min-height: 0; height: auto; flex: 1; margin-top: 2rpx; }
.composer-section { width: 100%; margin-top: 22rpx; box-sizing: border-box; }
.field-label { display: flex; min-height: 34rpx; margin-bottom: 10rpx; align-items: center; justify-content: space-between; gap: 18rpx; }
.field-label-main { min-width: 0; color: var(--text); font-size: 23rpx; font-weight: 600; line-height: 1.4; }
.field-hint { flex: none; color: var(--text-tertiary); font-size: 19rpx; font-weight: 400; line-height: 1.4; text-align: right; }
.field-control { display: flex; width: 100%; min-height: 78rpx; padding: 0 18rpx; align-items: center; gap: 10rpx; box-sizing: border-box; border: 1rpx solid #dfe4e0; border-radius: 13rpx; background: #f8f9f8; color: var(--text); font-size: 24rpx; }
.field-arrow { margin-left: auto; color: var(--text-tertiary); font-size: 31rpx; }
.text-input { width: 100%; min-height: 78rpx; margin-top: 12rpx; padding: 0 18rpx; box-sizing: border-box; border: 1rpx solid #dfe4e0; border-radius: 13rpx; background: #f8f9f8; font-size: 24rpx; }
.primary-text-input { margin-top: 0; }
.content-input { width: 100%; min-height: 164rpx; padding: 18rpx; box-sizing: border-box; border: 1rpx solid #dfe4e0; border-radius: 13rpx; background: #f8f9f8; font-size: 24rpx; line-height: 1.6; }
.rating-row { display: flex; width: 100%; align-items: stretch; gap: 12rpx; }
.rating-platform { min-width: 0; flex: 1; }
.rating-value-input { width: 190rpx; flex: 0 0 190rpx; margin-top: 0; }
.composer-footnote { margin: 18rpx 0 22rpx; color: var(--text-tertiary); font-size: 19rpx; line-height: 1.5; text-align: center; }
.composer-footer { flex: none; margin: 0 -28rpx; padding: 14rpx 28rpx calc(14rpx + env(safe-area-inset-bottom)); border-top: 1rpx solid var(--line); background: rgba(255,255,255,.98); }
.composer-submit { width: 100%; min-height: 84rpx; margin: 0; box-sizing: border-box; }
