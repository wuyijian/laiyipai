:host {
  display: block;
}

.custom-tab-bar {
  position: fixed;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 80;
  padding-bottom: constant(safe-area-inset-bottom);
  padding-bottom: env(safe-area-inset-bottom);
  border-top: 1rpx solid rgba(21, 26, 23, .08);
  background: rgba(255, 255, 255, .98);
  box-shadow: 0 -8rpx 28rpx rgba(18, 42, 31, .035);
}

.tab-bar {
  display: flex;
  align-items: stretch;
  height: 102rpx;
  padding: 4rpx 18rpx 0;
}

.tab-item {
  display: flex;
  flex: 1;
  min-width: 0;
  height: 98rpx;
  margin: 0;
  padding: 10rpx 0 6rpx;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border: 0;
  border-radius: 18rpx;
  background: transparent;
  color: #7b837e;
  font-size: 20rpx;
  line-height: 1;
}

.tab-item::after {
  display: none;
}

.tab-item--selected {
  color: #0f5c45;
}

.tab-item--pressed {
  background: #f3f7f4;
}

.tab-icon {
  position: relative;
  width: 44rpx;
  height: 44rpx;
  color: inherit;
}

.message-badge {
  position: absolute;
  z-index: 2;
  top: -8rpx;
  left: 31rpx;
  display: flex;
  min-width: 27rpx;
  height: 27rpx;
  padding: 0 7rpx;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  border: 3rpx solid #fff;
  border-radius: 999rpx;
  background: #d94b43;
  color: #fff;
  font-size: 16rpx;
  font-weight: 700;
  line-height: 1;
}

.icon-part {
  position: absolute;
  box-sizing: border-box;
}

.tab-label {
  display: block;
  margin-top: 7rpx;
  color: inherit;
  font-size: 20rpx;
  font-weight: 500;
  line-height: 24rpx;
  text-align: center;
}

.tab-item--selected .tab-label {
  font-weight: 600;
}

/* 首页：屋顶与门体都由边框绘制。 */
.tab-icon--home .icon-part--one {
  top: 6rpx;
  left: 10rpx;
  width: 25rpx;
  height: 25rpx;
  border-top: 4rpx solid currentColor;
  border-left: 4rpx solid currentColor;
  border-radius: 3rpx 0 0;
  transform: rotate(45deg);
}

.tab-icon--home .icon-part--two {
  right: 7rpx;
  bottom: 4rpx;
  left: 7rpx;
  height: 24rpx;
  border-right: 4rpx solid currentColor;
  border-bottom: 4rpx solid currentColor;
  border-left: 4rpx solid currentColor;
  border-radius: 0 0 5rpx 5rpx;
}

.tab-icon--home .icon-part--three {
  bottom: 4rpx;
  left: 19rpx;
  width: 10rpx;
  height: 17rpx;
  border: 4rpx solid currentColor;
  border-bottom: 0;
  border-radius: 4rpx 4rpx 0 0;
}

/* 发起：克制的圆角方框加号。 */
.tab-icon--publish .icon-part--one {
  top: 4rpx;
  left: 4rpx;
  width: 36rpx;
  height: 36rpx;
  border: 4rpx solid currentColor;
  border-radius: 12rpx;
}

.tab-icon--publish .icon-part--two {
  top: 13rpx;
  left: 20rpx;
  width: 4rpx;
  height: 18rpx;
  border-radius: 4rpx;
  background: currentColor;
}

.tab-icon--publish .icon-part--three {
  top: 20rpx;
  left: 13rpx;
  width: 18rpx;
  height: 4rpx;
  border-radius: 4rpx;
  background: currentColor;
}

/* 预约：日历轮廓和日期点。 */
.tab-icon--orders .icon-part--one {
  top: 8rpx;
  left: 5rpx;
  width: 34rpx;
  height: 31rpx;
  border: 4rpx solid currentColor;
  border-radius: 7rpx;
}

.tab-icon--orders .icon-part--one::before {
  position: absolute;
  top: 7rpx;
  right: 0;
  left: 0;
  height: 4rpx;
  background: currentColor;
  content: '';
}

.tab-icon--orders .icon-part--two,
.tab-icon--orders .icon-part--three {
  top: 4rpx;
  width: 4rpx;
  height: 10rpx;
  border-radius: 4rpx;
  background: currentColor;
}

.tab-icon--orders .icon-part--two {
  left: 13rpx;
}

.tab-icon--orders .icon-part--three {
  right: 13rpx;
}

/* 我的：头像与肩部轮廓。 */
.tab-icon--profile .icon-part--one {
  top: 4rpx;
  left: 15rpx;
  width: 16rpx;
  height: 16rpx;
  border: 4rpx solid currentColor;
  border-radius: 50%;
}

.tab-icon--profile .icon-part--two {
  right: 6rpx;
  bottom: 4rpx;
  left: 6rpx;
  height: 20rpx;
  border: 4rpx solid currentColor;
  border-bottom: 0;
  border-radius: 20rpx 20rpx 0 0;
}

.tab-icon--profile .icon-part--three {
  display: none;
}
